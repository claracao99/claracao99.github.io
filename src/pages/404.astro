---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
---

<BaseLayout title="Page not found" description="Page not found.">
  <div class="wrap missing">
    <SectionHead as="h1" italic="Nothing" rest="here" />
    <p>That page doesn't exist — it may have moved or never been published.</p>
    <p><a href="/">Back to the work</a></p>
  </div>
</BaseLayout>

<style>
  .missing {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-7);
    padding-bottom: var(--space-12);
    font-size: var(--text-md);
    color: var(--ink-body);
  }
</style>
