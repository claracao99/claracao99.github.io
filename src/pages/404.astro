---
// The Close-up site's 404: its header and stylesheet (public/closeup.css),
// standalone, since the homepage isn't an Astro page. The words sit where
// About puts her name: left, centred under the header.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Page not found – Clara Cao</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      // The theme before first paint: a saved choice, else the system's.
      document.documentElement.dataset.theme =
        localStorage.getItem('theme') ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    </script>
    <link rel="stylesheet" href="/closeup.css" />
    <style is:global>
      .missing {
        position: fixed;
        inset: var(--cut) 0 0;
        display: grid;
        align-content: center;
        justify-items: start;
        gap: 8px;
        padding: 0 var(--edge) calc((100svh - var(--cut)) * 0.08);
      }

      .missing__title {
        font-size: var(--t-big);
        line-height: 1.05;
        letter-spacing: -0.015em;
      }

      .missing__code {
        color: var(--grey);
      }

      .missing .b-link {
        margin-top: 24px;
      }
    </style>
  </head>
  <body data-view="work">
    <header class="bar">
      <a class="name" href="/">Clara Cao</a>
      <nav class="switch" aria-label="Main">
        <div class="switch__tabs">
          <a class="tab" href="/#work">Work</a>
          <a class="tab" href="/#work">Play</a>
          <a class="tab" href="/#about">About</a>
        </div>
      </nav>
      <div class="meta">
        <button class="theme" type="button" aria-label="Switch theme" data-theme-toggle>
          <svg viewBox="0 0 16 16" aria-hidden="true"
            ><circle cx="8" cy="8" r="6.4" fill="none" stroke="currentColor" stroke-width="1.2"></circle><path
              d="M8 1.6a6.4 6.4 0 0 0 0 12.8z"
              fill="currentColor"></path></svg
          >
        </button>
      </div>
    </header>

    <main class="missing">
      <p class="missing__code">404</p>
      <h1 class="missing__title">Page not found</h1>
      <p class="b-link"><a href="/">Back to the work</a></p>
    </main>

    <script is:inline>
      const root = document.documentElement;
      const toggle = document.querySelector('[data-theme-toggle]');
      const label = () =>
        toggle.setAttribute('aria-label', `Switch to ${root.dataset.theme === 'dark' ? 'light' : 'dark'} mode`);
      label();
      toggle.addEventListener('click', () => {
        root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        localStorage.setItem('theme', root.dataset.theme);
        label();
      });
    </script>
  </body>
</html>
