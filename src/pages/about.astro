---
/**
 * About: heading with a small portrait tucked in right after it, then two
 * columns — bio on the left; experience and contact on the right.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import PixelImage from '../components/PixelImage.astro';
import { CONTACT } from '../consts';
import portrait from '../assets/clara.jpg';

// TODO (Clara): the bio still names "[Company]" twice — fill those in.
const bio = [
  'Currently @Bolt, raising the quality bar for the ride-hailing experience.',
  'I thrive in spaces where I have high ownership and autonomy to create high quality experiences. I care more about shipping what matters than following stale processes. I would hand you a working prototype.',
  'At Bolt I led design for Order for someone else, which lets riders book a trip for a friend or family member, from the first framing through to the shipped flow. I built the team’s library of tappable prototypes on Clay, our design system, so explorations ship as real flows instead of static frames, and I write the component specs other designers build from. Before Bolt, I worked on mobility and marketplace products at [Company] and [Company].',
];

const experience = [
  { role: 'Product Designer', org: 'Bolt', href: 'https://bolt.eu', dates: '2025 — now' },
  { role: 'Product Designer Intern', org: 'Method', href: 'https://method.com', dates: '2025' },
  { role: 'MSc HCI', org: 'UCL', href: 'https://www.ucl.ac.uk', dates: '2024 — 2025' },
  { role: 'Data Analyst', org: 'Intropic', href: 'https://intropic.io', dates: '2022 — 2024' },
];
---

<BaseLayout title="About me" description="About Clara Cao, product designer at Bolt.">
  <div class="wrap about">
    <div class="about__head">
      <SectionHead as="h1" italic="About" lead="me" />
      <PixelImage
        class="about__portrait"
        src={portrait}
        alt="Clara Cao"
        width={874}
        height={720}
        widths={[218, 437]}
        sizes="7rem"
        format="webp"
        loading="eager"
      />
    </div>

    <div class="about__columns">
      <section class="about__bio" aria-label="Bio">
        {bio.map((p) => <p>{p}</p>)}
      </section>

      <div class="about__aside">
        <section class="block" aria-labelledby="experience">
          <h2 class="visually-hidden" id="experience">Experience</h2>
          <ul class="entries">
            {
              experience.map((e) => (
                <li class="entry">
                  <p class="entry__role">{e.role}</p>
                  <p class="entry__org">
                    <a href={e.href} target="_blank" rel="noopener noreferrer">
                      {e.org}<span class="visually-hidden"> (opens in a new tab)</span>
                    </a>
                    <span class="caps entry__dates">{e.dates}</span>
                  </p>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="block" aria-labelledby="contact">
          <h2 class="visually-hidden" id="contact">Contact</h2>
          <ol class="entries entries--numbered">
            {
              CONTACT.map((c, i) => (
                <li class="contact">
                  <span class="caps contact__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <a
                    class="entry__link"
                    href={c.href}
                    target={'external' in c && c.external ? '_blank' : undefined}
                    rel={'external' in c && c.external ? 'noopener noreferrer' : undefined}
                  >
                    {c.label}
                  </a>
                </li>
              ))
            }
          </ol>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Heading sits where "Selected works" does on the landing page: directly
   * under the nav, spaced by SectionHead's own block padding. */
  .about {
    padding-top: 0;
    padding-bottom: var(--space-6);
  }

  /* Small portrait sits right after the heading, vertically centred on the
   * type. Its height is a touch over the heading's line box (--text-display
   * × leading 1), so it scales with the title; the width follows from the media-tile ratio
   * (--media-ratio, --radius-sm) so it matches the landing-page tiles. */
  .about__head {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .about :global(.about__portrait) {
    flex: none;
    height: calc(var(--text-display) * var(--leading-display) * 1.2);
    aspect-ratio: var(--media-ratio);
    border-radius: var(--radius-sm);
  }

  /* Two columns, like the case study page: bio left, experience and contact
   * stacked on the right. Collapses to one column on phones. No top padding:
   * the row starts right after the heading, like the first project on the
   * landing page. */
  .about__columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: var(--column-gap);
    row-gap: var(--space-10);
  }

  @media (min-width: 48rem) {
    .about__columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }

  .about__aside {
    display: grid;
    gap: var(--space-10);
    align-content: start;
  }

  /* Bio is a lede: Title size and tracking, Regular weight, body leading. */
  .about__bio {
    display: grid;
    gap: var(--space-5);
    align-content: start;
    font-size: var(--text-title);
    font-weight: var(--weight-normal);
    line-height: var(--leading-body);
    letter-spacing: var(--tracking-title);
  }

  .entries {
    display: grid;
  }

  .entry {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-5);
    border-top: var(--rule-width) solid var(--rule);
  }

  .entry:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .entry:last-child {
    padding-bottom: 0;
  }

  .entry__role {
    line-height: var(--leading-title);
  }

  .entry__org {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    line-height: var(--leading-title);
  }

  /* Prose links: static 1px underline (base.css sets thickness and offset). */
  .entry__org a,
  .entry__link {
    text-decoration-line: underline;
  }

  .entry__dates {
    color: var(--ink-muted);
  }

  /* Contact rows: numbered, no hairlines. The link carries the height so the
   * whole row is tappable. */
  .entries--numbered {
    gap: var(--space-2);
  }

  .contact {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .contact__num {
    color: var(--ink-muted);
  }

  .entry__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
