---
/**
 * A case study as a full-screen, two-column page. Renders without client JS.
 */
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import NextProject from '../../components/NextProject.astro';
import { getCaseStudies } from '../../lib/work';

// Static paths come from the same helper as the landing page, so a draft is
// excluded from both the listing and its own route in production.
export async function getStaticPaths() {
  const projects = await getCaseStudies();
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <CaseStudyLayout entry={entry}>
    <Content />
  </CaseStudyLayout>
  <NextProject current={entry} />
</BaseLayout>
