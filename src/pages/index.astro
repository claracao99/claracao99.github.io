---
/**
 * The index (01 Index, Figma 487:792 / 493:825): the work as very round
 * cards, four to a row on desktop and two on phones, ordered by the entries'
 * `order`. The cards start a fixed distance down and stay 4:5 at every size,
 * like yuriroga.com; the page scrolls when they don't fit one screen. The
 * intro lives in the About panel (Nav.astro).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import { getPublishedWork } from '../lib/work';

// Drafts keep their pages in dev but stay off the grid.
const work = (await getPublishedWork()).filter((e) => !e.data.draft);
---

<BaseLayout fit>
  <h1 class="visually-hidden">Clara Cao, product designer: selected work</h1>

  <section class="index-grid cards" id="work" aria-label="Work">
    {work.map((entry, i) => <WorkCard entry={entry} eager={i === 0} />)}
  </section>
</BaseLayout>

<style>
  .cards {
    row-gap: var(--index-row-gap);
    /* Measured from under the header (main clears it). */
    padding-top: var(--index-lead);
  }
</style>
