---
/**
 * The index (01 Index, Figma 487:792 / 493:825): the intro, then the work as
 * very round cards. Each desktop row pairs a wide case study with a portrait
 * visual piece, sides alternating; that comes from the entries' `order` and
 * `card`, so keep the pairs in step when adding work.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import { getPublishedWork } from '../lib/work';

// Drafts keep their pages in dev but stay off the grid, which is laid out in
// pairs.
const work = (await getPublishedWork()).filter((e) => !e.data.draft);
---

<BaseLayout>
  <div class="index-grid">
    <h1 class="intro span-wide">
      Clara Cao is a product designer at Bolt, shaping the app millions of people use to get
      around their city. She finds the problem worth solving, builds the answer in real code with
      AI, and turns messy flows into calm, effortless experiences.
    </h1>
  </div>

  <section class="index-grid cards" id="work" aria-label="Work">
    {work.map((entry, i) => <WorkCard entry={entry} index={i + 1} eager={i === 0} />)}
  </section>
</BaseLayout>

<style>
  /* Measured from under the header (main clears it). */
  .intro {
    padding: 96px var(--pill-pad) 72px;
    font-size: var(--text-intro);
    font-weight: var(--weight-normal);
    line-height: var(--leading-intro);
    letter-spacing: 0;
  }

  /* A size container, so the cards can size themselves off its width (cqw). */
  .cards {
    container-type: inline-size;
    row-gap: var(--index-row-gap);
    margin-top: var(--index-gap);
  }

  @media (min-width: 48rem) {
    .intro {
      padding-block: 160px 120px;
    }
  }
</style>
