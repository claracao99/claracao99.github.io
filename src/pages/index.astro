---
/**
 * The index (01 Index, Figma 487:792 / 493:825): the intro (name, about,
 * contacts), then the work as very round square cards of one fixed size,
 * two to a row from 32rem and one on narrower phones, ordered by the
 * entries' `order`.
 *
 * From 48rem it all stands in one row with two ends instead (the rail),
 * across the middle of the screen: the page doesn't scroll, the wheel (or a
 * drag) slides the row sideways, and each tile turns away as it leaves the
 * middle, as if on the inside of a drum, after details.so's Perspective
 * Cards. The intro, then Work, an arrow, then Play on its own white ground.
 * Reduced motion keeps the grid.
 *
 * The header's Work / Play switch (Nav.astro) follows the row and
 * glides it to the part pressed; on the grid, Work and Play swap the tiles.
 * Play is the side projects, so far the lamp (LampTile.astro) and
 * placeholders.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import LampTile from '../components/LampTile.astro';
import ArrowRight from '../icons/arrow-right.svg';
import Media from '../components/Media.astro';
import { getPublishedWork } from '../lib/work';
import { SITE, CONTACT } from '../consts';
import TriangleEast from '../icons/triangle-east.svg';

// Drafts keep their pages in dev but stay off the grid.
const work = (await getPublishedWork()).filter((e) => !e.data.draft);
const email = CONTACT.find((c) => c.href.startsWith('mailto:'))!;
const links = CONTACT.filter((c) => !c.href.startsWith('mailto:'));
---

<BaseLayout fit>
  <h1 class="visually-hidden">Clara Cao, product designer: selected work</h1>
  {/* The case pages are fetched up front and readied in full as a tile is
      hovered (Chromium), so the page is there the moment the dolly lands. */}
  <script type="speculationrules" is:inline>
    {
      "prefetch": [{ "where": { "href_matches": "/work/*" }, "eagerness": "eager" }],
      "prerender": [{ "where": { "href_matches": "/work/*" }, "eagerness": "moderate" }]
    }
  </script>

  <section class="rail" id="work" aria-label="Work">
    {/* Play's own ground, white, sliding in behind Play (script below). */}
    <div class="rail__play-bg" aria-hidden="true"></div>
    <div class="rail__stage">
      <div class="index-grid cards">
        {/* The intro, at the row's start: the name big, who I am, how to
            reach me. On the rail the header's small name takes over once the
            big one has gone (script below). */}
        <section class="rail-intro" aria-label="About">
          <p class="rail-intro__name logotype" aria-hidden="true">{SITE.name}</p>
          <p class="rail-intro__about">{SITE.intro}</p>
          <ul class="rail-intro__contact">
            {/* The address copies (Nav.astro's script), never opens mail. */}
            <li>
              <button class="rail-intro__copy" type="button" data-copy={email.label}>
                {email.label}
                <span class="rail-intro__status" aria-live="polite" data-copy-status>Copy</span>
              </button>
            </li>
            {
              links.map((c) => (
                <li>
                  <a href={c.href} target="_blank" rel="noopener noreferrer">
                    {c.label}
                    <TriangleEast aria-hidden="true" />
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
        {work.map((entry, i) => <WorkCard entry={entry} eager={i === 0} />)}
        {/* On the rail Work runs on into Play: an arrow in the space between
            them says there's more that way (a placeholder for now). Off the
            rail (the grid) it never shows. */}
        <div class="rail-divider" data-view="divider" aria-hidden="true" hidden>
          <ArrowRight />
        </div>
        <LampTile data-view="play" hidden />
        {/* Placeholders until Play has more pieces. */}
        {(['phone', 'card', 'panel'] as const).map((shape) => (
          <div class="play-tile" data-view="play" hidden aria-hidden="true">
            <Media shape={shape} />
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Play's ground: a white layer slides in behind the row,
   * faster than it (parallax), a clean cut; the script places it (--play-edge).
   * The wordmark turns dark on it (data-on-play). */
  .rail__play-bg {
    display: none;
  }
  @media (min-width: 48rem) and (prefers-reduced-motion: no-preference) {
    .rail[data-active] .rail__play-bg {
      display: block;
      position: fixed;
      inset: 0;
      background: var(--play-bg);
      /* A clean cut at the edge; past the window's left, all of it. */
      clip-path: inset(0 0 0 var(--play-edge, 100vw));
    }
  }
  :global(html[data-on-play] .nav__home) {
    color: var(--play-ink);
  }
  /* The switch and the arrow each turn once Play's white is under them. */
  :global(html[data-on-play-nav] .nav__views) {
    --ink: var(--play-ink);
    --ink-detail: var(--play-ink-detail);
    --pill-glass: var(--play-pill-glass);
  }
  :global(.rail-divider[data-on-play]) {
    --ink-detail: var(--play-ink-detail);
  }

  /* Play's tiles are light (a pale card, darker placeholder shapes),
   * whatever the page around them. */
  .cards > :global([data-view='play']) {
    --figure: var(--play-figure);
    --surface-placeholder: var(--play-shape);
  }

  /* A placeholder Play tile: square, round, pale, its shape in the middle. */
  .play-tile {
    position: relative;
    aspect-ratio: var(--tile-ratio);
    min-width: 0;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--figure);
  }

  .play-tile :global(.media) {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
    border-radius: 0;
    background: none;
  }

  /* The intro: on phones a block over the tiles (the header already has
   * the name); on the rail the row's first thing, flat, as tall as a tile:
   * the name filling its width at the top, the about under it, the
   * contacts at the bottom. */
  .rail-intro {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-5);
    color: var(--ink);
    /* The site's one text size: 11 / 14, as in the nav and the case card. */
    font-size: var(--text-small);
    line-height: var(--leading-small);
    letter-spacing: var(--tracking-small);
  }

  .rail-intro__name {
    display: none;
  }

  .rail-intro__about {
    max-width: 40em;
  }

  .rail-intro__contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    list-style: none;
  }

  .rail-intro__copy {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    letter-spacing: inherit;
    cursor: pointer;
  }

  .rail-intro__status {
    color: var(--ink-detail);
  }

  .rail-intro__copy:hover .rail-intro__status {
    color: var(--ink);
  }

  .rail-intro__contact a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--ink);
    text-decoration: none;
  }

  .rail-intro__contact a:hover {
    color: var(--ink-detail);
  }

  .rail-intro__contact :global(svg) {
    width: 5px;
    height: 7px;
    --icon: currentColor;
  }

  /* No captions under the cards: rows sit one gutter apart, like columns.
   * One tile to a row on phones, two from 32rem (tokens.css). */
  .cards {
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--index-gap);
  }

  @media (min-width: 32rem) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Leaving for a case (script below): the chosen tile travels bare. */
  :global(html[data-leaving]) .cards :global(.work-card__inner :is(.work-card__pill, .work-card__play).pill.pill) {
    opacity: 0;
  }

  .cards > :global([hidden]) {
    display: none;
  }

  /* Switching Work / Play: the tiles fade out, change, and fade back. */
  .cards {
    transition: opacity var(--duration-base) var(--ease-out);
  }

  .rail[data-switching] .cards {
    opacity: 0;
  }

  /* The rail: the page holds still and the stage fills the window, the row
   * across its middle. The tiles stand on one spot and the script slides each
   * along (index.astro below); the stage lends them one vanishing point, its
   * centre. */
  @media (min-width: 48rem) and (prefers-reduced-motion: no-preference) {
    :global(html:has(.rail[data-active])) {
      overflow: hidden;
    }

    .rail__stage {
      user-select: none;
      position: fixed;
      inset: 0;
      display: flex;
      align-items: center;
      overflow: hidden;
      perspective: var(--rail-perspective);
      touch-action: none;
    }

    .rail .cards {
      position: relative;
      display: block;
      width: 100%;
      height: var(--rail-tile);
      margin: 0;
      column-gap: var(--rail-gap); /* not laid out: the script reads it in px */
      transform-style: preserve-3d;
      /* In 3D the row shares the middle tile's plane and would take its
       * pointer: only the tiles catch it. */
      pointer-events: none;
    }

    /* Between Work and Play: a tile's room, empty but for an arrow on. */
    .rail[data-active] .rail-divider:not([hidden]) {
      display: grid;
      place-items: center;
      color: var(--ink-detail);
    }

    .rail-divider :global(svg) {
      width: var(--icon-rail-arrow);
      height: var(--icon-rail-arrow);
    }

    /* On the rail: flat, a tile tall, the about at the top and the contacts
     * down at the bottom edge. */
    .rail[data-active] .rail-intro {
      width: var(--rail-intro);
      padding: 0;
      backface-visibility: visible;
    }

    /* The big name, the intro's first line (the header's small one takes
     * over once it's gone, script below). */
    .rail[data-active] .rail-intro__name {
      display: block;
      width: max-content;
      margin-bottom: var(--space-3);
      font-size: var(--text-intro-name);
      white-space: nowrap;
    }

    .rail[data-active] .rail-intro__contact {
      margin-top: auto;
      flex-direction: column;
      gap: var(--space-1);
    }

    .rail .cards > :global(*) {
      position: absolute;
      left: 0;
      top: 0;
      width: var(--rail-tile);
      height: var(--rail-tile);
      backface-visibility: hidden;
      pointer-events: auto;
      will-change: transform;
    }

    /* Once a tile is tapped the row slides under a resting pointer: tiles
     * passing beneath it mustn't wake (a pill fading in, a film preview
     * starting), which dropped frames mid-move. */
    :global(html[data-leaving]) .rail .cards > :global(*) {
      pointer-events: none;
    }
  }
</style>

<script>
  import { cssMs } from '../lib/css';

  // Back from a case page (not a reload): its tile is the one the cover
  // travels back into (PageTransition.astro), so the rail starts on it.
  {
    const activation = (window as { navigation?: { activation?: { navigationType: string; from?: { url: string } | null } } })
      .navigation?.activation;
    const from = activation ? (activation.navigationType === 'reload' ? '' : activation.from?.url) : document.referrer;
    let path = '';
    try {
      if (from) path = new URL(from, location.href).pathname.replace(/\/+$/, '');
    } catch {}
    const link = path.startsWith('/work/')
      ? [...document.querySelectorAll<HTMLAnchorElement>('a.work-card__inner')].find((a) => a.pathname.replace(/\/+$/, '') === path)
      : null;
    if (link) link.closest<HTMLElement>('.work-card')!.dataset.vtCover = '';
  }

  // Set by the rail while it's live. dollyIn: the camera pushes into the
  // drum on `tile`, resolving once it's there (the page then opens).
  // dollyOut: back from its case, the drum gathers round `tile` again.
  let dollyIn: ((tile: HTMLElement) => Promise<void>) | null = null;
  let dollyOut: ((tile: HTMLElement) => void) | null = null;

  // The rail (from 48rem): the wheel, a trackpad or a swipe moves the row,
  // eased towards where it's sent (Lenis's lerp, SmoothScroll.astro). The
  // tiles stand one step apart in one row with two ends: the intro (flat;
  // its big name hands over to the header's small one as it leaves),
  // Work's projects,
  // an arrow in a tile's room, then Play's. It opens on its first project
  // in the middle, the intro beside it, and goes from there (no further
  // back than the intro in line with the wordmark) to its last tile in the
  // middle: whatever the row brings to the middle (the switch, the keys,
  // focus, a tap) lands dead centre. The
  // header's switch shows which half is in the middle and glides the row
  // to the other. Several stand in view at
  // once and the next is cut off by the window's edge, the sign there's more. Each turns by
  // how far its centre is from the window's: flat in the middle, its outer
  // edge swinging in towards the edges, the drum's inside.
  {
    const rail = document.querySelector<HTMLElement>('.rail');
    const row = rail?.querySelector<HTMLElement>('.cards');
    const wide = matchMedia('(min-width: 48rem) and (prefers-reduced-motion: no-preference)');
    if (rail && row) {
      // Every tile is Work's unless marked otherwise; the shown view's stand
      // in the row, the rest are hidden.
      const all = [...row.children].filter(
        (el) => !(el instanceof HTMLScriptElement) && !el.matches('.rail-intro'),
      ) as HTMLElement[];
      // The intro, before the tiles; its big name, which hands over to the
      // header's small one as it leaves (draw()).
      const intro = row.querySelector<HTMLElement>('.rail-intro');
      const slot = intro?.querySelector<HTMLElement>('.rail-intro__name') ?? null;
      let introSpace = 0; // the intro's width and two gaps
      let slotAt = { x: 0, w: 1 }; // the big name, relative to the row's start
      const viewOf = (el: HTMLElement) => el.dataset.view ?? 'work';
      let tiles = all.filter((el) => viewOf(el) === 'work');
      const lerp = 0.13;
      let on = false;
      let width = 0; // the window
      let size = 0; // a tile
      let step = 0; // a tile and the gap after it
      // How far the row moves: from where it opens (or, if the intro is cut
      // off there, the intro at the wordmark's left edge) to its last tile
      // in the middle.
      let lo = 0;
      let end = 0;
      const clamp = (v: number) => Math.max(lo, Math.min(end, v));
      let angle = 0;
      let at = 0; // how far the row has moved
      let to = 0; // where it's going
      let frame = 0;
      // The dolly (0 at rest, 1 pushed in) and the tile it pushes in on.
      let dolly = 0;
      let focus: HTMLElement | null = null;
      // The tile to start on, if not the first.
      let start: HTMLElement | null = row.querySelector<HTMLElement>('.work-card[data-vt-cover]');

      // Where Play starts in the row: the divider, between Work and Play.
      const divider = all.find((el) => viewOf(el) === 'divider') ?? null;
      // The grid's view (phones), Work or Play; on the rail both show.
      let view = 'work';
      // Which half of the row is in the middle, as the header's switch shows.
      const switches = [...document.querySelectorAll<HTMLButtonElement>('.nav__view')];
      let centred: string | null = null;
      const showView = (v: string) => {
        if (v === centred) return;
        centred = v;
        switches.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === v)));
      };
      // Where the row is when `el` stands in the middle.
      const centreOf = (el: HTMLElement) =>
        el === intro ? lo : introSpace + Math.max(0, tiles.indexOf(el)) * step;
      // A view's place in the row: its first tile in the middle.
      const placeOf = (v: string) =>
        v === 'play' && divider ? clamp(introSpace + (all.indexOf(divider) + 1) * step) : clamp(introSpace);
      let opening = true;
      let playEdge = -1;
      let playSpeed = 1; // --play-speed
      // The wordmark's right edge: once Play's ground reaches it, it turns dark.
      const mark = document.querySelector('.nav__home')?.getBoundingClientRect();
      const wordmark = mark?.right ?? 0;
      const wordmarkLeft = mark?.left ?? 0;

      const measure = () => {
        on = wide.matches;
        // Marks the row live: the page doesn't scroll, the cursor doesn't
        // frame its turned tiles (Cursor.astro), they open without the outline.
        rail.toggleAttribute('data-active', on);
        if (!on) {
          window.smoothScroll?.start();
          all.forEach((el) => (el.hidden = viewOf(el) !== view));
          tiles = all.filter((el) => !el.hidden);
          all.forEach((t) => (t.style.transform = ''));
          if (intro) intro.style.transform = '';
          document.documentElement.toggleAttribute('data-name-in', true);
          return;
        }
        // The whole row: Work, the divider, Play.
        all.forEach((el) => (el.hidden = false));
        tiles = all;
        window.smoothScroll?.stop();
        window.scrollTo(0, 0);
        const style = getComputedStyle(rail);
        width = document.documentElement.clientWidth;
        size = tiles[0].offsetWidth;
        step = size + (parseFloat(getComputedStyle(row).columnGap) || 0);
        angle = parseFloat(style.getPropertyValue('--rail-angle')) || 0;
        playSpeed = parseFloat(style.getPropertyValue('--play-speed')) || 1;
        // The intro: its width and a gap either side, before the tiles.
        introSpace = intro ? intro.offsetWidth + 2 * (step - size) : 0;
        // The ends: the landing, or the intro in line with the wordmark if
        // that's further back (never an empty half screen before it); the
        // last tile in the middle.
        lo = intro ? Math.min(introSpace, (width - size) / 2 - wordmarkLeft) : 0;
        end = Math.max(lo, introSpace + (tiles.length - 1) * step);
        // The big name's place in the intro.
        if (slot) slotAt = { x: slot.offsetLeft, w: slot.offsetWidth || 1 };
        if (opening && !start) at = to = placeOf('work'); // the landing: the first project
        opening = false;
        at = clamp(at);
        to = clamp(to);
        if (start) {
          at = to = clamp(centreOf(start));
          // Back from its case: open on the drum still pushed in, so it can
          // gather round the tile as the cover lands (dollyOut).
          if (tiles.includes(start) && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
            focus = start;
            dolly = 1;
          }
          start = null;
        }
        draw();
      };

      const draw = () => {
        frame = 0;
        if (!on) return;
        at += (to - at) * lerp;
        if (Math.abs(to - at) < 0.1) at = to;
        // The first tile's left edge, in the middle before the row moves.
        const first = (width - size) / 2 - at;
        // The intro, flat, from the row's start; the tiles after it.
        if (intro) {
          intro.style.transform = `translate3d(${first.toFixed(2)}px, 0, 0)`;
          const away = focus ? dolly : 0;
          intro.style.opacity = away ? String(1 - away * 0.8) : '';
          intro.style.filter = away ? `blur(${(away * 8).toFixed(1)}px)` : '';
        }
        // The name hands over: on landing only the intro's big name shows;
        // once it's mostly gone off the left, the header's small one rolls
        // up into place (Nav.astro), and back out when the intro returns:
        // always one name, never two.
        if (slot) {
          const right = first + slotAt.x + slotAt.w;
          const startRight = (width - size) / 2 - lo + slotAt.x + slotAt.w;
          const gone = 1 - right / startRight; // 0 at rest, 1 off the left
          document.documentElement.toggleAttribute('data-name-in', gone > 0.65);
        }
        tiles.forEach((tile, i) => {
          const x = first + introSpace + i * step;
          // -1 at the left edge, 0 in the middle, 1 at the right edge.
          const d = Math.max(-1.25, Math.min(1.25, (x + size / 2 - width / 2) / (width / 2)));
          // Eased a little, so the middle stays flat and the turn builds
          // towards the edges.
          let turn = -Math.sign(d) * Math.abs(d) ** 1.3 * angle;
          let x2 = x;
          let z = 0;
          let grow = 1;
          // The dolly: the chosen tile comes a little forward; the rest sink
          // back, part to the sides, turn further round the drum and fall
          // into shadow, out of focus.
          if (focus && dolly > 0) {
            // As a scale, not a step forward: the page transition takes the
            // tile up as it's drawn without the stage's perspective.
            if (tile === focus) grow = 1 + dolly * dollyPush;
            else {
              const side = Math.sign(x + size / 2 - width / 2) || 1;
              x2 += side * dolly * size * 0.4;
              z -= dolly * dollySink;
              turn -= side * dolly * 24;
            }
          }
          tile.style.transform = `translate3d(${x2.toFixed(2)}px, 0, ${z.toFixed(1)}px) rotateY(${turn.toFixed(2)}deg)${grow !== 1 ? ` scale(${grow.toFixed(4)})` : ''}`;
          const away = focus && tile !== focus ? dolly : 0;
          tile.style.opacity = away ? String(1 - away * 0.8) : '';
          tile.style.filter = away ? `blur(${(away * 8).toFixed(1)}px) brightness(${(1 - away * 0.5).toFixed(2)})` : '';
        });
        // Play is where the row is once the arrow is past the window's
        // middle, or at its end.
        if (divider) {
          const arrow = first + introSpace + all.indexOf(divider) * step + size / 2;
          showView(arrow < width / 2 || at >= end - 1 ? 'play' : 'work');
          // Play's own ground comes in behind the row, faster than it
          // (parallax): its edge enters at the window's right with the arrow
          // and sweeps left --play-speed times as fast as the row, so it
          // overtakes the tiles. The wordmark goes dark on it.
          const arrowAt = divider.getBoundingClientRect().right;
          const edge = Math.round(Math.max(0, Math.min(width + 1, width - playSpeed * (width - arrowAt))));
          if (edge !== playEdge) {
            playEdge = edge;
            document.documentElement.style.setProperty('--play-edge', `${edge}px`);
            document.documentElement.toggleAttribute('data-on-play', edge < wordmark);
            document.documentElement.toggleAttribute('data-on-play-nav', edge < width / 2);
            divider.toggleAttribute('data-on-play', edge < arrowAt - size / 2);
          }
        }
        if (at !== to) frame = requestAnimationFrame(draw);
      };

      // The tweens below (the dolly's, the jumps'): only the latest moves
      // the row, one started over another takes over from it. A jump
      // (`jumping`, its tween) gives way to the wheel or a drag.
      let tweening = 0;
      let jumping = 0;
      const stopJump = () => {
        if (jumping === tweening) tweening++;
        jumping = 0;
      };

      const go = (by: number) => {
        if ('leaving' in document.documentElement.dataset) return;
        stopJump();
        to = clamp(to + by);
        frame ||= requestAnimationFrame(draw);
      };

      // Either way the wheel turns: down and right go on, up and left back.
      addEventListener(
        'wheel',
        (e) => {
          if (!on || e.ctrlKey) return; // ctrl: pinch zoom
          e.preventDefault();
          const unit = e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? width : 1;
          go((Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY) * unit);
        },
        { passive: false },
      );

      // The keys bring the next tile (or the one before) to the middle.
      addEventListener('keydown', (e) => {
        if (!on || e.metaKey || e.ctrlKey || e.altKey) return;
        const dir = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
        if (!dir) return;
        e.preventDefault();
        const stops = [...(intro ? [intro] : []), ...tiles.filter((t) => t !== divider)].map(centreOf);
        const next = dir > 0 ? stops.find((c) => c > to + 1) : stops.findLast((c) => c < to - 1);
        if (next !== undefined) go(next - to);
      });

      // The dolly's moves: an eased tween of the row's place and of the
      // push. A tile tapped off to the side first glides to the middle
      // (centre), then the camera pushes in on it there (dollyIn). Resolves
      // when it's done.
      const dollyPush = 0.05; // the chosen tile's growth, pushed in
      const dollySink = 520; // px away
      // Ease in and out, cubic: a camera's move, no lurch in the middle (and
      // never the wheel's lurch at the start).
      const easeInOut = (k: number) => (k < 0.5 ? 4 * k ** 3 : 1 - (-2 * k + 2) ** 3 / 2);
      // `speed`: how fast the row is already going (px/ms), so a glide
      // picks it up where it is instead of stopping it dead first.
      const tween = (target: number, from: number, by: number, delay: number, duration: number, speed = 0) =>
        new Promise<void>((done) => {
          cancelAnimationFrame(frame);
          frame = 0;
          const id = ++tweening;
          const t0 = performance.now() + delay;
          const d0 = dolly;
          // From a moving start: a Hermite curve leaving at that speed and
          // settling at rest.
          const m = speed * duration;
          const place = speed
            ? (k: number) => by * (3 * k ** 2 - 2 * k ** 3) + m * (k ** 3 - 2 * k ** 2 + k)
            : (k: number) => by * easeInOut(k);
          const tick = () => {
            if (id !== tweening) return done();
            const k = Math.min(1, Math.max(0, (performance.now() - t0) / duration));
            const e = easeInOut(k);
            at = to = from + place(k);
            dolly = d0 + (target - d0) * e;
            draw();
            if (k < 1) requestAnimationFrame(tick);
            else done();
          };
          requestAnimationFrame(tick);
        });

      // The glide to the middle takes longer the further the tile is, up
      // to 1.6 times --duration-centre.
      const centring = (by: number) =>
        (cssMs(document.documentElement, '--duration-centre') || 550) *
        Math.min(1.6, Math.max(0.8, Math.sqrt(Math.abs(by) / step)));

      dollyIn = async (tile) => {
        if (!on || !tiles.includes(tile)) return;
        const push = cssMs(document.documentElement, '--duration-dolly') || 700;
        const by = centreOf(tile) - at;
        // Still gliding from the wheel or a fling: its next frame's step.
        const speed = at === to ? 0 : ((to - at) * lerp) / (1000 / 60);
        if (Math.abs(by) > 2 || speed) await tween(0, at, by, 0, centring(by), speed);
        focus = tile;
        await tween(1, at, 0, 0, push);
      };

      dollyOut = (tile) => {
        if (!on || focus !== tile || dolly === 0) return;
        // Once the cover is on its way home.
        const root = document.documentElement;
        const delay = (cssMs(root, '--duration-travel') || 700) * 0.3;
        tween(0, at, 0, delay, cssMs(root, '--duration-dolly') || 700).then(() => {
          focus = null;
          draw();
        });
      };

      // Tabbing to a tile brings it to the middle. Only the keyboard's
      // focus: a press focuses the link too (Chromium), and that move would
      // fight the tap's own glide (dollyIn).
      row.addEventListener('focusin', (e) => {
        if (!on || !(e.target as Element).matches(':focus-visible')) return;
        const tile = tiles.find((t) => t.contains(e.target as Node));
        if (!tile) return;
        go(centreOf(tile) - to);
      });

      // Mouse, touch and pen: drag the row, and let go with a fling (the
      // cursor names the wheel, the easier way, over the space round the
      // drum, Cursor.astro). A drag
      // doesn't open the tile it started on, and never picks up the card's
      // link or picture. The lamp's cord keeps its own drag.
      let drag: { id: number; x: number; y: number; moved: number; v: number; t: number } | null = null;
      let dragged = 0; // when the last drag ended, if it moved
      rail.addEventListener(
        'click',
        (c) => {
          if (c.timeStamp - dragged > 400) return;
          c.preventDefault();
          c.stopPropagation();
        },
        { capture: true },
      );
      rail.addEventListener('dragstart', (e) => on && e.preventDefault());
      rail.addEventListener('pointerdown', (e) => {
        if (!on || e.button !== 0 || (e.target as Element).closest('.lamp-tile')) return;
        drag = { id: e.pointerId, x: e.clientX, y: e.clientY, moved: 0, v: 0, t: e.timeStamp };
        rail.toggleAttribute('data-dragging', true);
      });
      rail.addEventListener('pointermove', (e) => {
        if (!drag || e.pointerId !== drag.id) return;
        const dx = e.clientX - drag.x;
        const dy = e.clientY - drag.y;
        const by = -(Math.abs(dx) > Math.abs(dy) ? dx : dy);
        drag.moved += Math.abs(by);
        drag.v = by / Math.max(1, e.timeStamp - drag.t);
        Object.assign(drag, { x: e.clientX, y: e.clientY, t: e.timeStamp });
        // A press that wobbles a little is still a tap: the row stays put.
        if (drag.moved <= 8) return;
        stopJump();
        // Caught where it is (still gliding, perhaps), and carried from there.
        at = clamp(at + by);
        to = at;
        frame ||= requestAnimationFrame(draw);
      });
      const release = (e: PointerEvent) => {
        if (!drag || e.pointerId !== drag.id) return;
        // Only a drag lets go with a fling.
        if (drag.moved > 8) {
          dragged = e.timeStamp;
          go(drag.v * 180);
        }
        drag = null;
        rail.removeAttribute('data-dragging');
      };
      rail.addEventListener('pointerup', release);
      rail.addEventListener('pointercancel', release);

      const ms = (name: string) => cssMs(document.documentElement, name);
      // A jump along the row (the switch, the wordmark): one eased glide,
      // --duration-row whatever the distance.
      const jump = (place: number) => {
        if ('leaving' in document.documentElement.dataset) return;
        const by = place - at;
        if (Math.abs(by) <= 1) return;
        tween(0, at, by, 0, ms('--duration-row') || 900);
        jumping = tweening;
      };
      // The header's switch: on the rail it glides the row to that half; on
      // the grid the tiles fade out, change, and fade back.
      document.addEventListener('index-view', (e) => {
        const chosen = (e as CustomEvent<string>).detail;
        if (on) jump(placeOf(chosen));
        else swap(chosen);
      });

      // The grid: Work and Play swap tiles, fading out and back.
      const swap = async (chosen: string) => {
        view = chosen;
        rail.toggleAttribute('data-switching', true);
        await new Promise((r) => setTimeout(r, ms('--duration-base') || 200));
        measure();
        rail.removeAttribute('data-switching');
      };

      // The wordmark: back to the landing. The row glides to its first
      // project; the grid goes back to Work and up to the top.
      document.addEventListener('index-home', () => {
        if (on) return jump(placeOf('work'));
        switches.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === 'work')));
        if (view !== 'work') swap('work');
        window.smoothScroll
          ? window.smoothScroll.scrollTo(0, { duration: (ms('--duration-row') || 900) / 1000, easing: easeInOut })
          : window.scrollTo(0, 0); // reduced motion: straight there
      });

      addEventListener('resize', measure);
      wide.addEventListener('change', measure);
      // Back out of the bfcache: the page there still holds still.
      addEventListener('pageshow', (e) => e.persisted && measure());
      // Again once Lenis is up (SmoothScroll.astro), to hold it still too.
      addEventListener('load', measure);
      measure();
    }
  }

  // Opening a case from its tile. On the rail, the camera dollies in: the
  // row glides the tile to the middle as the rest of the drum sinks back
  // into shadow, one move (dollyIn); then the page opens and the tile, now
  // flat and centred, grows into the case page's cover (PageTransition.astro,
  // case-tile) as the page arrives under it. On the grid (phones) the other
  // tiles just fall out of focus first. Back from the case, the reverse: the
  // cover shrinks home and the drum gathers round it (dollyOut).
  // Modified clicks and reduced motion open as usual.
  const root = document.documentElement;
  const shown = () => [...document.querySelectorAll<HTMLElement>('.cards > :not([hidden]):not(script)')];

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    // Opens `href`, from `tile` if it's shown (a project's card).
    const open = async (href: string, tile: HTMLElement | null) => {
      if ('leaving' in root.dataset) return;
      root.dataset.leaving = '';
      window.smoothScroll?.stop();
      // Only this tile travels: never one marked by an earlier visit.
      document.querySelectorAll('[data-vt-cover]').forEach((el) => el.removeAttribute('data-vt-cover'));
      if (tile && !tile.hidden) tile.dataset.vtCover = '';
      else tile = null;
      const duration = cssMs(root, '--duration-dolly') || 700;
      let move: Promise<unknown> | undefined;
      if (tile && document.querySelector('.rail[data-active]')) move = dollyIn?.(tile);
      else if (tile) {
        const others = shown().filter((el) => el !== tile);
        move = Promise.all(
          others.map(
            (el) =>
              el.animate([{}, { opacity: 0, filter: 'blur(8px) brightness(0.5)' }], {
                duration: duration * 0.6,
                easing: 'ease-out',
                fill: 'forwards',
              }).finished,
          ),
        );
      }
      // Never hold the page hostage to the move: open after it, or after a
      // beat longer than it should take (the glide to the middle at its
      // longest, then the push), whichever comes first.
      const longest = duration + 1.6 * (cssMs(root, '--duration-centre') || 550);
      await Promise.race([move?.catch(() => {}), new Promise((r) => setTimeout(r, longest + 400))]);
      location.assign(href);
    };
    const plain = (e: MouseEvent) =>
      e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || !('onpagereveal' in window);
    const path = (a: HTMLAnchorElement) => a.pathname.replace(/\/+$/, '');
    // Every card, copies included (the drum repeats its set).
    const links = () => [...document.querySelectorAll<HTMLAnchorElement>('a.work-card__inner[href^="/work/"]')];
    // Of the cards for `href`, the one nearest the middle of the window.
    const nearest = (href: string) => {
      const target = path(Object.assign(document.createElement('a'), { href }));
      let best: HTMLElement | null = null;
      let gap = Infinity;
      for (const a of links()) {
        if (path(a) !== target) continue;
        const card = a.closest<HTMLElement>('.work-card');
        if (!card || card.hidden) continue;
        const r = card.getBoundingClientRect();
        const d = Math.abs(r.left + r.width / 2 - innerWidth / 2);
        if (d < gap) [best, gap] = [card, d];
      }
      return best;
    };

    // Delegated, so the drum's copies open the same way as the originals.
    document.addEventListener('click', (e) => {
      const link = (e.target as Element).closest?.<HTMLAnchorElement>('a.work-card__inner[href^="/work/"]');
      if (!link || plain(e) || e.defaultPrevented) return; // modified, or no transition: open as usual
      e.preventDefault();
      open(link.href, link.closest<HTMLElement>('.work-card'));
    });

    // The header's Work list opens the same way, from the project's card
    // nearest the middle: the panel closes and the camera dollies in on it.
    for (const item of document.querySelectorAll<HTMLAnchorElement>('.nav__item[href^="/work/"]')) {
      item.addEventListener('click', (e) => {
        if (plain(e)) return;
        e.preventDefault();
        document.dispatchEvent(new Event('nav-close'));
        open(item.href, nearest(item.href));
      });
    }

    // Back from a case page: the drum opened pushed in on its tile (the
    // rail) and gathers round it now, under the transition.
    const returning = document.querySelector<HTMLElement>('.work-card[data-vt-cover]');
    if (returning) dollyOut?.(returning);

    // Back out of the bfcache: the drum is still pushed in; gather it.
    addEventListener('pageshow', (e) => {
      if (!e.persisted) return;
      delete root.dataset.leaving;
      if (!document.querySelector('.rail[data-active]')) window.smoothScroll?.start();
      shown().forEach((el) => el.getAnimations().forEach((a) => a.cancel()));
      const tile = document.querySelector<HTMLElement>('.work-card[data-vt-cover]');
      if (tile) dollyOut?.(tile);
    });
  }
</script>
