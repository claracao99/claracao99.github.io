---
/**
 * Landing page: header, then "Selected works" (one block per case study).
 * "Read more" links to the case-study page.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import { getPublishedWork } from '../lib/work';

const work = await getPublishedWork();
---

<BaseLayout>
  <section class="wrap works" aria-labelledby="selected-works">
    <SectionHead italic="Selected" lead="works" id="selected-works" />
    {
      work.length === 0 ? (
        <p class="empty">Nothing published yet.</p>
      ) : (
        work.map((entry, i) => <ProjectEntry entry={entry} eager={i === 0} />)
      )
    }
  </section>

</BaseLayout>

<style>
  .works {
    padding-top: 0;
  }

  /* The first project follows the heading directly; later ones get the
   * tighter top padding from ProjectEntry. */
  .works > :global(.project:first-of-type) {
    padding-top: 0;
  }

  .empty {
    color: var(--ink-muted);
  }
</style>
