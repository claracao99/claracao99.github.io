---
/**
 * Case study as a full-screen, two-column page (after ol.studio/interior):
 *
 *   left   — the entry's media, edge to edge, one viewport-high panel each
 *   right  — the text: title, client · year, summary, then the MDX body.
 *            Sticky, so it stays put while the media scrolls past.
 *
 * On phones the media stacks above the text. No client JS: media comes from
 * the entry's frontmatter, the body from <slot />.
 */
import Media from '../components/Media.astro';
import type { WorkEntry } from '../lib/work';

interface Props {
  entry: WorkEntry;
}

const { entry } = Astro.props;
const { title, summary, client, year, draft, media } = entry.data;
const meta = [client, String(year)].filter(Boolean).join(' · ');
const headingId = `case-${entry.id}`;
---

<div class="case-page">
  <div class="case-page__media" role="group" aria-label={`${title} — media`}>
    {
      media.map((item, i) => (
        <Media {...item} eager={i === 0} sizes="(max-width: 48rem) 100vw, 50vw" />
      ))
    }
  </div>

  <article class="case" aria-labelledby={headingId} data-lenis-prevent>
    {draft && <p class="case__draft caps">Draft — visible in development only</p>}
    <header class="case__caption">
      <h1 class="case__title" id={headingId}>{title}</h1>
      <p class="case__meta caps">{meta}</p>
      <p class="case__summary">{summary}</p>
    </header>

    <div class="case__body">
      <slot />
    </div>
  </article>
</div>
