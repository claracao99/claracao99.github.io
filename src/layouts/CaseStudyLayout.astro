---
/**
 * Case study page, after yuriroga.com/work/*, on the index grid (TilePage):
 * one column, two tiles wide on desktop and one on phones.
 *
 *   first  — the index card's own picture (the cover photo, or the phone
 *            video), square, so the page opens on what was clicked.
 *   then   — a Figure card, as tall as its text: Information (project,
 *            company, year), Description (summary and the MDX body).
 *   then   — the frontmatter `media`: `small` as square tiles, `large` at
 *            its own ratio.
 *
 * The project row carries the project name (the title before its colon) as
 * the page's h1. Media without an image is a placeholder tile, and an entry
 * with no media gets a default set, so every page reads as a full page
 * until the exports exist.
 */
import Media from '../components/Media.astro';
import TilePage from '../components/TilePage.astro';
import DeviceVideo from '../components/DeviceVideo.astro';
import { projectName, type WorkEntry } from '../lib/work';
import { tileSizes } from '../lib/media';

interface Props {
  entry: WorkEntry;
}

type Item = NonNullable<WorkEntry['data']['media']>[number];

const { entry } = Astro.props;
const { summary, company, year, draft, cover, stage } = entry.data;
const name = projectName(entry);

const placeholders: Item[] = [
  { shape: 'phone', size: 'small', alt: '' },
  { shape: 'panel', size: 'large', alt: '' },
  { shape: 'phone', size: 'small', alt: '' },
  { shape: 'card', size: 'small', alt: '' },
];
const tiles: Item[] = entry.data.media ?? placeholders;

const ratio = (item: Item) =>
  item.size === 'large' ? (item.src ? item.src.width / item.src.height : 16 / 9) : 1;
const sizes = (item: Item) => tileSizes(item.src, ratio(item), { wide: true });

const info = [
  ['Company', company],
  ['Year', String(year)],
].filter((row): row is [string, string] => Boolean(row[1]));
---

<TilePage labelledby="case-title" tilesLabel={`${name}, images`}>
  <Fragment slot="card">
    {draft && <p class="case__draft">Draft, visible in development only</p>}
    <section class="case__section">
      <h2 class="case__label">Information</h2>
      <dl class="case__details">
        <div>
          <dt>Project:</dt>
          <dd><h1 id="case-title">{name}</h1></dd>
        </div>
        {
          info.map(([term, value]) => (
            <div>
              <dt>{term}:</dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>
    </section>
    <section class="case__section">
      <h2 class="case__label">Description</h2>
      <p>{summary}</p>
      <div class="case__body">
        <slot />
      </div>
    </section>
  </Fragment>
  <div class="case__tile" data-size="small" style="--ratio: 1" slot="cover">
    {
      cover.video && cover.src ? (
        <DeviceVideo video={cover.video} poster={cover.src} alt={cover.alt} eager wide stage={stage} />
      ) : (
        <Media {...cover} eager sizes={sizes({ ...cover, size: 'small' })} widths={[640, 960, 1440, 1920, 2000]} />
      )
    }
  </div>
  {
    tiles.map((item) => (
      <div class="case__tile" data-size={item.size} style={`--ratio: ${ratio(item)}`}>
        <Media {...item} sizes={sizes(item)} widths={[640, 960, 1440, 1920, 2000]} />
      </div>
    ))
  }
</TilePage>
