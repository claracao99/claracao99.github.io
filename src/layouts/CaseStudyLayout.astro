---
/**
 * The case-study article: caption (title, client · year, summary), then the
 * MDX body via <slot />. The body's first <MediaRow> is the lead media.
 *
 * Rendered by /work/[slug]/ as a full page, and lifted from there into the
 * landing-page sheet by CaseSheet.astro — so this must stay a self-contained
 * <article class="case"> styled by styles/case.css (global).
 */
import type { WorkEntry } from '../lib/work';

interface Props {
  entry: WorkEntry;
}

const { entry } = Astro.props;
const { title, summary, client, year, draft } = entry.data;
const meta = [client, String(year)].filter(Boolean).join(' · ');
---

<article class="case wrap" aria-labelledby={`case-${entry.id}`}>
  {
    draft && (
      <p class="case__draft caps">Draft — visible in development only</p>
    )
  }
  <header class="case__caption">
    <div>
      <h1 class="case__title" id={`case-${entry.id}`}>{title}</h1>
      <p class="case__meta caps">{meta}</p>
    </div>
    <p class="case__summary">{summary}</p>
  </header>

  <div class="case__body">
    <slot />
  </div>
</article>

<style is:global>
  .case__draft {
    margin-bottom: var(--space-5);
    color: var(--ink-muted);
  }
</style>
