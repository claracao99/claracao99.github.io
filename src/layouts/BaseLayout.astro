---
/**
 * The outermost layout: <head>, metadata, global styles, header, footer.
 * Every page goes through this.
 */
import { SITE } from '../consts';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SmoothScroll from '../components/SmoothScroll.astro';
import PageTransition from '../components/PageTransition.astro';
import Cursor from '../components/Cursor.astro';
import Sound from '../components/Sound.astro';
import Lamp from '../components/Lamp.astro';

import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/case.css';

interface Props {
  title?: string;
  description?: string;
  /** Path to an OG image, relative to the site root. */
  ogImage?: string;
  /** Fit header, main and footer into one screen, no scroll (the index). */
  fit?: boolean;
}

const { title, description = SITE.description, ogImage, fit = false } = Astro.props;

// Landing page uses the bare site title; inner pages get a suffix.
const pageTitle = title ? `${title} — ${SITE.name}` : SITE.title;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site) : undefined;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#ffffff" />
    <!-- Theme before first paint: light unless the lamp was last pulled on
         (lib/theme.ts). The colour is --grey-00 in dark. -->
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'dark') {
          document.documentElement.dataset.theme = 'dark';
          document.querySelector('meta[name="theme-color"]').content = '#0b0b0b';
        }
      } catch {}
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <meta name="generator" content={Astro.generator} />
    <PageTransition />
  </head>

  <body class:list={{ 'page-fit': fit }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Lamp />
    <SmoothScroll />
    <Cursor />
    <Sound />
    <!-- Cookieless analytics (claracao.goatcounter.com). Skips localhost. -->
    <script
      is:inline
      async
      data-goatcounter="https://claracao.goatcounter.com/count"
      src="https://gc.zgo.at/count.js"></script>
  </body>
</html>
