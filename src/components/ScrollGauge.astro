---
/**
 * Reading-progress bar pinned to the top edge, as on andmade.jp: a 3px ink
 * line that scales from 0 to full width as the page scrolls. Decorative only
 * (aria-hidden), hidden on phones where it competes with the browser
 * chrome. Works with or without Lenis, since Lenis still moves the native
 * scroll position.
 */
---

<div class="gauge" aria-hidden="true">
  <div class="gauge__bar" data-scroll-gauge></div>
</div>

<style>
  .gauge {
    position: fixed;
    inset-inline: 0;
    top: 0;
    height: var(--gauge-height);
    z-index: var(--z-gauge);
    pointer-events: none;
    display: none;
  }

  @media (min-width: 48rem) {
    .gauge {
      display: block;
    }
  }

  .gauge__bar {
    width: 100%;
    height: 100%;
    background: var(--ink);
    transform-origin: left;
    transform: scaleX(0);
    will-change: transform;
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-scroll-gauge]');

  if (bar) {
    let ticking = false;

    const update = () => {
      ticking = false;
      if (bar.dataset.resetting) return;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const progress = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      bar.style.transform = `scaleX(${progress})`;
    };

    const request = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    update();
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', request);

    /*
     * Before an automatic hand-off to the next project (NextProject.astro),
     * wind the bar back to zero so the next page starts from an empty gauge
     * rather than a jump cut. Resolves when the animation has finished.
     */
    window.addEventListener('gauge:reset', (e) => {
      const { done } = (e as CustomEvent<{ done: () => void }>).detail;
      const ms = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--duration-reset')) || 0;
      const hold = ms ? 200 : 0; // rest on empty for a beat before the new page
      bar.dataset.resetting = 'true';
      bar.style.transition = `transform ${ms}ms var(--ease-in-out)`;
      bar.style.transform = 'scaleX(0)';
      window.setTimeout(done, ms + hold);
    });
  }
</script>
