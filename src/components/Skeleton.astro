---
/**
 * Placeholder bars for a case-study section that isn't written yet.
 *
 * Lets a partial project ship honestly — the section reads as deliberately
 * unfinished rather than as missing or broken.
 */
interface Props {
  lines?: number;
}

const { lines = 3 } = Astro.props;

// Varying widths so the block reads as text rather than a loading spinner.
const widths = ['100%', '92%', '78%', '85%', '64%'];
---

<div class="skeleton" role="presentation">
  {
    Array.from({ length: lines }).map((_, i) => (
      <span class="skeleton__line" style={`width: ${widths[i % widths.length]}`} />
    ))
  }
</div>

<style>
  .skeleton {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-block: var(--space-5);
  }

  .skeleton__line {
    height: 0.75rem;
    background: var(--rule);
    border-radius: var(--radius-sm);
  }
</style>
