---
/**
 * One selected work on the landing page: media row, then title + date on the
 * left and description + "Read more" on the right.
 *
 * "Read more" links to /work/<slug>/ (or out to externalUrl).
 */
import MediaRow from './MediaRow.astro';
import ArrowRight from './ArrowRight.astro';
import { caseStudyPath, type WorkEntry } from '../lib/work';

interface Props {
  entry: WorkEntry;
  eager?: boolean;
}

const { entry, eager = false } = Astro.props;
const { title, summary, date, media, externalUrl, draft } = entry.data;
const href = externalUrl ?? caseStudyPath(entry);
const headingId = `project-${entry.id}`;
---

<article class="project" aria-labelledby={headingId}>
  <MediaRow items={media} eager={eager} />
  <div class="project__caption grid">
    <div class="project__title col-1">
      <h3 class="title" id={headingId}>
        <a class="project__title-link" href={href} {...(externalUrl ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
          {title}
        </a>
        {draft && <span class="project__draft">Draft</span>}
      </h3>
      <p class="caps">{date}</p>
    </div>
    <div class="project__description col-2">
      <p>{summary}</p>
      {
        externalUrl ? (
          <a class="more" href={href} target="_blank" rel="noopener noreferrer">
            <span class="more__label">Read more</span><span class="visually-hidden"> about {title} (opens in a new tab)</span>
            <span class="more__arrow">
              <ArrowRight class="more__arrow-out" />
              <ArrowRight class="more__arrow-in" />
            </span>
          </a>
        ) : (
          <a class="more" href={href}>
            <span class="more__label">Read more</span><span class="visually-hidden"> about {title}</span>
            <span class="more__arrow">
              <ArrowRight class="more__arrow-out" />
              <ArrowRight class="more__arrow-in" />
            </span>
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .project {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-10) var(--space-8);
  }

  /* Title in column 1, description in column 2, column 3 empty. */
  .project__caption {
    column-gap: var(--column-gap);
  }


  .project__title {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  /* Title links to the case study. Same hover as the header links: no
   * underline, just a soft fade to the muted grey. */
  .project__title-link {
    color: inherit;
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-out);
  }

  .project__title-link:hover,
  .project__title-link:focus-visible {
    color: var(--ink-muted);
  }

  .project__draft {
    margin-left: var(--space-2);
    padding: 2px var(--space-2);
    border: 1px dashed var(--rule);
    border-radius: var(--radius-sm);
    font: var(--weight-normal) var(--text-label) var(--font-mono);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
    vertical-align: middle;
  }

  .project__description {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    color: var(--ink-body);
  }

  /* "Read more" is set in the body face. min-height keeps the tap target at 44px. */
  .more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: var(--weight-bold);
    line-height: var(--leading-body);
    color: var(--ink);
    text-decoration: none;
  }

  /*
   * Underline sweep on hover: the underline exits to the right, then instantly
   * re-enters from the left. One keyframe run, no state to reset.
   */
  .more__label {
    position: relative;
  }

  .more__label::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    /* Just under the baseline: the line box carries descender + leading space. */
    bottom: 0.14em;
    height: 1px;
    background: currentColor;
    transform-origin: left;
  }

  .more:hover .more__label::after,
  .more:focus-visible .more__label::after {
    animation: underline-sweep var(--duration-sweep) linear;
  }

  @keyframes underline-sweep {
    0% {
      transform: translateX(0) scaleX(1);
      animation-timing-function: cubic-bezier(0.6, 0.18, 0.17, 0.72);
    }
    50% {
      transform: translateX(100%) scaleX(0);
      animation-timing-function: step-end;
    }
    50.01% {
      transform: translateX(0) scaleX(0);
      animation-timing-function: cubic-bezier(0.6, 0.18, 0.17, 0.72);
    }
    100% {
      transform: translateX(0) scaleX(1);
    }
  }

  /*
   * Arrow swap on hover: the visible arrow slides out to the right while a
   * second copy slides in from the left. The return trip is instant so the
   * arrow is back in place before the next hover. Durations are tokens, so
   * prefers-reduced-motion zeroes them globally.
   */
  .more__arrow {
    position: relative;
    display: inline-grid;
    overflow: hidden;
  }

  .more__arrow > :global(svg) {
    grid-area: 1 / 1;
    transition: translate 0ms var(--ease-out);
  }

  .more__arrow > :global(.more__arrow-in) {
    translate: -200% 0;
  }

  .more:hover .more__arrow > :global(svg),
  .more:focus-visible .more__arrow > :global(svg) {
    transition-duration: var(--duration-slow);
  }

  .more:hover .more__arrow > :global(.more__arrow-out),
  .more:focus-visible .more__arrow > :global(.more__arrow-out) {
    translate: 200% 0;
  }

  .more:hover .more__arrow > :global(.more__arrow-in),
  .more:focus-visible .more__arrow > :global(.more__arrow-in) {
    translate: 0 0;
  }
</style>
