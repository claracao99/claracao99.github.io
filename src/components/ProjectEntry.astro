---
/**
 * One selected work on the landing page: media row, then title + date on the
 * left and description + "Read more" on the right.
 *
 * "Read more" is a real link to /work/<slug>/. On the landing page a script
 * intercepts it and opens the case study in a sheet; without JS, or when
 * opened in a new tab, the link still works.
 */
import MediaRow from './MediaRow.astro';
import { caseStudyPath, type WorkEntry } from '../lib/work';

interface Props {
  entry: WorkEntry;
  eager?: boolean;
}

const { entry, eager = false } = Astro.props;
const { title, summary, date, media, externalUrl, draft } = entry.data;
const href = externalUrl ?? caseStudyPath(entry);
const headingId = `project-${entry.id}`;
---

<article class="project" aria-labelledby={headingId}>
  <MediaRow items={media} eager={eager} />
  <div class="project__caption grid">
    <div class="project__title col-1">
      <h3 id={headingId}>
        {title}
        {draft && <span class="project__draft">Draft</span>}
      </h3>
      <p class="caps">{date}</p>
    </div>
    <div class="project__description col-2-3">
      <p>{summary}</p>
      {
        externalUrl ? (
          <a class="more" href={href} target="_blank" rel="noopener noreferrer">
            Read more<span class="visually-hidden"> about {title} (opens in a new tab)</span>
          </a>
        ) : (
          <a class="more" href={href} data-sheet data-sheet-title={title}>
            Read more<span class="visually-hidden"> about {title}</span>
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .project {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-5) var(--space-8);
  }


  .project__title {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .project__title h3 {
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
  }

  .project__draft {
    margin-left: var(--space-2);
    padding: 2px var(--space-2);
    border: 1px dashed var(--rule);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-weight: var(--weight-normal);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--ink-muted);
    vertical-align: middle;
  }

  .project__description {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    max-width: var(--measure-wide);
    font-size: var(--text-md);
  }

  /* Same treatment as the header link: medium weight, underline on hover.
   * min-height keeps the tap target at 44px without a visible box. */
  .more {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-nav);
    color: var(--ink);
    text-decoration: none;
  }

  .more:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
