---
/**
 * One project on the index (01 Index): a very round card, then its title.
 * Every card is one track of the index grid, 4:5 at every width, after
 * yuriroga.com. A cover photo shows full bleed; a cover video shows the
 * prototype in a phone on Figure grey, looping on its own (DeviceVideo). The case page opens on this same tile.
 *
 * Cards link to their case page (or out to externalUrl); on hover the cursor
 * frames the card (Cursor.astro). Pieces with `caseStudy:
 * false` have no page and no link. A title too long for its card scrolls (Marquee).
 */
import Media from './Media.astro';
import Marquee from './Marquee.astro';
import DeviceVideo from './DeviceVideo.astro';
import { caseStudyPath, type WorkEntry } from '../lib/work';
import { tileSizes } from '../lib/media';

interface Props {
  entry: WorkEntry;
  eager?: boolean;
}

const { entry, eager = false } = Astro.props;
const { title, cover, caseStudy, externalUrl, stage, stageMobile } = entry.data;
const href = externalUrl ?? (caseStudy ? caseStudyPath(entry) : undefined);
const sizes = tileSizes(cover.src, { phone: [50, 4 / 5], desktop: [25, 4 / 5] });
const Tag = href ? 'a' : 'div';
const linkProps = href
  ? { href, ...(externalUrl ? { target: '_blank', rel: 'noopener noreferrer' } : {}) }
  : {};
---

<article class="work-card">
  <Tag class="work-card__inner" {...linkProps}>
    <div
      class="work-card__media"
      data-cursor-frame={href ? '' : undefined}
    >
      {
        cover.video && cover.src ? (
          <DeviceVideo video={cover.video} poster={cover.src} alt={cover.alt} eager={eager} stage={stage} stageMobile={stageMobile} />
        ) : (
          <Media {...cover} eager={eager} sizes={sizes} widths={[640, 960, 1440, 1920, 2000]} />
        )
      }
    </div>
    <p class="work-card__caption">
      <span class="work-card__title">
        <Marquee text={title} />
      </span>
    </p>
  </Tag>
</article>

<style>
  /* 4:5 at every width, as yuriroga.com: the card's width comes from its
   * track (2 on phones, 4 on desktop) and its height follows, so the shape
   * never changes with the screen. Radius is a flat 32px at every size,
   * matching marco.fyi's tiles. */
  .work-card {
    --card-radius: var(--radius-card);
    min-width: 0;
  }

  .work-card__inner {
    display: flex;
    flex-direction: column;
    gap: var(--caption-gap);
    color: var(--ink);
    text-decoration: none;
  }

  .work-card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--card-radius);
    background: var(--figure);
    /* Safari: clip the zooming child to the radius. */
    isolation: isolate;
  }

  /* Media.astro's well, stretched to the card. */
  .work-card__media :global(.media) {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
    border-radius: 0;
    background: none;
  }

  a.work-card__inner:focus-visible {
    outline: none;
  }

  a.work-card__inner:focus-visible .work-card__media {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .work-card__caption {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    padding-inline: var(--pill-pad);
    font-size: var(--text-small);
    line-height: var(--leading-small);
    letter-spacing: var(--tracking-small);
  }

  .work-card__title {
    flex: 1 1 0;
    min-width: 0;
  }

  @media (min-width: 48rem) {
    .work-card__caption {
      gap: var(--space-3);
    }
  }
</style>
