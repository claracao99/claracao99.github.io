---
/**
 * One project on the index (01 Index): a very round card, one track of the
 * index grid, square (--tile-ratio) at every width, after yuriroga.com. A
 * cover photo shows full bleed; a cover video shows the prototype in a phone
 * on Figure grey, looping on its own (DeviceVideo). The case page opens on
 * this same tile, which slides there along the grid (index.astro).
 *
 * Cards link to their case page (or out to externalUrl); on hover the cursor
 * frames the card (Cursor.astro) and a glass pill with the short title
 * (projectName) fades in at its centre. Touch screens can't hover, so
 * there the pill always shows. The full title stays for screen readers.
 * Pieces with `caseStudy: false` have no page and no link.
 */
import Media from './Media.astro';
import DeviceVideo from './DeviceVideo.astro';
import { caseStudyPath, projectName, type WorkEntry } from '../lib/work';
import { tileSizes } from '../lib/media';

interface Props {
  entry: WorkEntry;
  eager?: boolean;
}

const { entry, eager = false } = Astro.props;
const { title, cover, caseStudy, externalUrl, stage } = entry.data;
const href = externalUrl ?? (caseStudy ? caseStudyPath(entry) : undefined);
const sizes = tileSizes(cover.src);
const Tag = href ? 'a' : 'div';
const linkProps = href
  ? { href, ...(externalUrl ? { target: '_blank', rel: 'noopener noreferrer' } : {}) }
  : {};
---

<article class="work-card">
  <Tag class="work-card__inner" {...linkProps}>
    <div
      class="work-card__media"
      data-cursor-frame={href ? '' : undefined}
    >
      {
        cover.video && cover.src ? (
          <DeviceVideo video={cover.video} poster={cover.src} alt={cover.alt} eager={eager} stage={stage} />
        ) : (
          <Media {...cover} eager={eager} sizes={sizes} widths={[640, 960, 1440, 1920, 2000]} />
        )
      }
      <span class="pill work-card__pill" aria-hidden="true">{projectName(entry)}</span>
    </div>
    <span class="visually-hidden">{title}</span>
  </Tag>
</article>

<style>
  /* Square at every width (--tile-ratio): the card's width comes from its
   * track and its height follows, so the shape
   * never changes with the screen. Radius is a flat 32px at every size,
   * matching marco.fyi's tiles. */
  .work-card {
    --card-radius: var(--radius-card);
    min-width: 0;
  }

  .work-card__inner {
    display: block;
    color: var(--ink);
    text-decoration: none;
  }

  .work-card__media {
    position: relative;
    aspect-ratio: var(--tile-ratio);
    overflow: hidden;
    border-radius: var(--card-radius);
    background: var(--figure);
    /* Safari: clip the zooming child to the radius. */
    isolation: isolate;
  }

  /* Media.astro's well, stretched to the card. */
  .work-card__media :global(.media) {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
    border-radius: 0;
    background: none;
  }

  a.work-card__inner:focus-visible {
    outline: none;
  }

  a.work-card__inner:focus-visible .work-card__media {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  /* The short title, on glass, centred on the card. */
  .work-card__pill {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    z-index: 1;
    max-width: calc(100% - 2 * var(--index-gap));
    overflow: hidden;
    text-overflow: ellipsis;
    pointer-events: none;
  }

  @media (hover: hover) {
    .work-card__pill {
      opacity: 0;
      transform: translateY(4px);
      transition:
        opacity var(--duration-base) var(--ease-out),
        transform var(--duration-base) var(--ease-out);
    }
    .work-card__inner:hover .work-card__pill,
    .work-card__inner:focus-visible .work-card__pill {
      opacity: 1;
      transform: none;
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: reduce) {
    .work-card__pill {
      transform: none;
    }
  }
</style>
