---
/**
 * A single project in the work grid. Used by /work and the landing page.
 */
import { Image } from 'astro:assets';
import type { WorkEntry } from '../lib/work';

interface Props {
  entry: WorkEntry;
  /** First card in a grid loads eagerly; the rest lazily. */
  eager?: boolean;
}

const { entry, eager = false } = Astro.props;
const { title, summary, year, cover, coverAlt, externalUrl, draft } =
  entry.data;

const href = externalUrl ?? `/work/${entry.id}/`;
const isExternal = Boolean(externalUrl);
---

<article class="card">
  <a
    class="card__link"
    href={href}
    target={isExternal ? '_blank' : undefined}
    rel={isExternal ? 'noopener noreferrer' : undefined}
  >
    <div class="card__media">
      <Image
        src={cover}
        alt={coverAlt}
        widths={[320, 640, 960]}
        sizes="(max-width: 40rem) 100vw, (max-width: 72rem) 50vw, 36rem"
        format="webp"
        loading={eager ? 'eager' : 'lazy'}
      />
    </div>
    <div class="card__text">
      <h3 class="card__title">
        {title}
        {draft && <span class="card__badge">Draft</span>}
      </h3>
      <p class="card__summary">{summary}</p>
      <p class="card__year">
        {year}{isExternal && <span aria-hidden="true"> ↗</span>}
        {isExternal && <span class="visually-hidden">(opens in a new tab)</span>}
      </p>
    </div>
  </a>
</article>

<style>
  /* The whole card is one link, so the hit area is the full block — important
   * on touch, where a text-only target is fiddly. */
  .card__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .card__media {
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--surface-sunken);
  }

  .card__media :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .card__link:hover .card__media :global(img) {
    transform: scale(1.02);
  }

  .card__text {
    margin-top: var(--space-4);
  }

  .card__title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xl);
  }

  .card__link:hover .card__title {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .card__badge {
    padding: 2px var(--space-2);
    border: 1px dashed var(--rule-strong);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .card__summary {
    margin-top: var(--space-2);
    max-width: var(--measure);
    color: var(--ink-secondary);
  }

  .card__year {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
</style>
