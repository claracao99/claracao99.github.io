---
/**
 * An image that arrives pixelated and resolves into focus.
 *
 * Two layers, same trick as locomotive.ca:
 * 1. A ~12px wide version of the image is generated at build time and set as
 *    the wrapper's background with `image-rendering: pixelated`, so the browser
 *    block-scales it into a mosaic instead of smoothing it into a blur. It is
 *    there before any JS runs.
 * 2. Once the real <img> decodes, a canvas redraws it at 4, 8 then 12 columns, big blocks only,
 *    steps, then removes itself and fades the real image in.
 *
 * Reduced motion skips the stepped resolve and just swaps.
 */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'img'>, 'src' | 'width' | 'height'> {
  src: ImageMetadata;
  alt: string;
  width: number;
  height: number;
  widths?: number[];
  sizes?: string;
  format?: 'webp' | 'avif' | 'png' | 'jpeg';
  quality?: number;
  loading?: 'eager' | 'lazy';
  /** Class applied to the wrapper; the <img> itself gets `pixel__img`. */
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  widths,
  sizes,
  format = 'webp',
  quality = 85,
  loading = 'lazy',
  class: className,
  ...rest
} = Astro.props;

// The mosaic. 6 columns: barely a portrait, deliberately chunky.
const tiny = await getImage({ src, width: 6, format: 'webp', quality: 60 });
---

<span
  class:list={['pixel', className]}
  style={`--pixel-placeholder: url('${tiny.src}'); aspect-ratio: ${width} / ${height};`}
  data-pixel
>
  <Image
    class="pixel__img"
    src={src}
    alt={alt}
    width={width}
    height={height}
    widths={widths}
    sizes={sizes}
    format={format}
    quality={quality}
    loading={loading}
    {...rest}
  />
</span>

<style>
  .pixel {
    position: relative;
    display: block;
    overflow: hidden;
    background-image: var(--pixel-placeholder);
    background-size: cover;
    background-position: center;
    image-rendering: pixelated;
  }

  .pixel :global(.pixel__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* image-rendering is inherited; the real photo must resample smoothly. */
    image-rendering: auto;
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-out);
  }

  .pixel.is-loaded :global(.pixel__img) {
    opacity: 1;
  }

  .pixel.is-loaded {
    background-image: none;
  }

  .pixel :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    pointer-events: none;
  }
</style>

<script>
  const STEPS = [4, 8, 12];
  const HOLD_MS = 240;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

  async function resolve(wrap: HTMLElement, img: HTMLImageElement) {
    if (!reduceMotion) {
      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d');
      if (ctx) {
        wrap.appendChild(canvas);
        const ratio = img.naturalHeight / img.naturalWidth;
        for (const cols of STEPS) {
          // Draw the image into a canvas that is only `cols` pixels wide;
          // CSS scales it back up with hard edges. Bigger canvas, finer mosaic.
          canvas.width = cols;
          canvas.height = Math.max(1, Math.round(cols * ratio));
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
          await wait(HOLD_MS);
        }
        wrap.classList.add('is-loaded');
        // Let the real image fade in over the big blocks before pulling them.
        await wait(200);
        canvas.remove();
        return;
      }
    }
    wrap.classList.add('is-loaded');
  }

  for (const wrap of document.querySelectorAll<HTMLElement>('[data-pixel]')) {
    const img = wrap.querySelector<HTMLImageElement>('img');
    if (!img) continue;
    const start = () => img.decode().catch(() => {}).then(() => resolve(wrap, img));
    if (img.complete && img.naturalWidth) start();
    else img.addEventListener('load', start, { once: true });
    img.addEventListener('error', () => wrap.classList.add('is-loaded'), { once: true });
  }
</script>
