---
/**
 * The lamp (Lamp.astro) at its usual size, in the lower right corner of a
 * square tile on Figure grey, the same size as the cards beside it: Play's
 * first project, for now on its own. Pulling its cord turns it on.
 */
import Lamp from './Lamp.astro';

const props = Astro.props;
---

<div class="lamp-tile" {...props}>
  <Lamp />
</div>

<style>
  .lamp-tile {
    position: relative;
    aspect-ratio: var(--tile-ratio);
    min-width: 0;
    border-radius: var(--radius-card);
    background: var(--figure);
    /* The lamp's frame runs past the corner; on phones the tile reaches the
     * screen's margin, so clip it or the page scrolls sideways. */
    overflow-x: clip;
  }
</style>
