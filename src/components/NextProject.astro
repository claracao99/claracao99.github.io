---
/**
 * End of a case study: a Next Project pill (wrapping to the first), like the
 * other pills. It cycles through what the index shows, so drafts are skipped
 * in dev too. It sits under the tiles, the grid's full width, like them.
 */
import TriangleEast from '../icons/triangle-east.svg';
import { caseStudyPath, getCaseStudies, projectName, type WorkEntry } from '../lib/work';

interface Props {
  current: WorkEntry;
}

const { current } = Astro.props;
const all = (await getCaseStudies()).filter((e) => !e.data.draft || e.id === current.id);
const i = all.findIndex((e) => e.id === current.id);
const next = all.length > 1 ? all[(i + 1) % all.length] : undefined;
---

{
  next && (
    <nav class="index-grid next" aria-label="Next project">
      <a class="pill pill--filled next__link" href={caseStudyPath(next)}>
        <span>
          Next Project<span class="visually-hidden">: {projectName(next)}</span>
        </span>
        <TriangleEast aria-hidden="true" />
      </a>
    </nav>
  )
}

<style>
  .next {
    margin-top: var(--index-gap);
  }

  .next__link {
    grid-column: 1 / -1;
  }
</style>
