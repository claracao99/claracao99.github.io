---
/**
 * End of a case study: a single centred link to the next case study
 * (wrapping to the first).
 */
import { caseStudyPath, getCaseStudies, type WorkEntry } from '../lib/work';

interface Props {
  current: WorkEntry;
}

const { current } = Astro.props;
const all = await getCaseStudies();
const i = all.findIndex((e) => e.id === current.id);
const next = all.length > 1 ? all[(i + 1) % all.length] : undefined;
---

{
  next && (
    <section class="next" aria-label="Next project">
      <a class="next__link caps" href={caseStudyPath(next)}>
        Next project →<span class="visually-hidden">: {next.data.title}</span>
      </a>
    </section>
  )
}

<style>
  .next {
    display: grid;
    place-items: center;
    padding-block: var(--space-12);
  }

  .next__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--space-4);
    color: var(--ink-muted);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-out);
  }

  .next__link:hover,
  .next__link:focus-visible {
    color: var(--ink);
  }
</style>

