---
/**
 * A prototype clip in the iPhone 17 frame (Figma Cover page, "iPhone
 * Mockups"), staged like marco.fyi's command_dot tile.
 *
 * At rest the phone holds the clip's first frame. On hover (tap on touch,
 * focus from the keyboard) it moves and scales to its end position over
 * 300ms, and the clip plays. Leaving reverses it and rewinds the clip, so
 * the next look starts from the beginning. Nothing plays until someone asks.
 *
 * Both positions come from `stage`, measured on the Figma board "Device tile
 * · phone positions" (549:1867). The default is marco.fyi's: large and low
 * at rest, running off the bottom edge, then 65% size and raised.
 *
 * Fills its parent, which must be positioned and clip its overflow.
 */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import frame from '../assets/device/iphone-17-black.png';

interface Props {
  video: string;
  /** The clip's first frame. */
  poster: ImageMetadata;
  alt?: string;
  label?: string;
  eager?: boolean;
  /** Phone left, top and width in px on a 347.5×434.375 card. */
  stage?: { start: Spot; end: Spot };
}

type Spot = { x: number; y: number; w: number };

const CARD = { w: 347.5, h: 434.375 };
const PHONE = 920 / 450;

const {
  video,
  poster,
  alt = '',
  label,
  eager = false,
  stage = {
    start: { x: 27.8, y: 137.7, w: 291.9 },
    end: { x: 78.88, y: 63.1, w: 189.74 },
  },
} = Astro.props;
const { start, end } = stage;
// Rest is laid out in % of the card; the end is a transform from it, in %
// of the phone's own box (origin top left), so it scales with the card.
const startH = start.w * PHONE;
const style = [
  `--x: ${(start.x / CARD.w) * 100}%`,
  `--y: ${(start.y / CARD.h) * 100}%`,
  `--w: ${(start.w / CARD.w) * 100}%`,
  `--dx: ${((end.x - start.x) / start.w) * 100}%`,
  `--dy: ${((end.y - start.y) / startH) * 100}%`,
  `--k: ${end.w / start.w}`,
].join('; ');
const posterImage = await getImage({ src: poster, width: 750, format: 'webp' });
---

<div class="device-tile" data-device-tile tabindex="0" role="group" aria-label={label ?? alt ?? undefined}>
  <div class="device" style={style}>
    <video
      class="device__screen"
      src={video}
      poster={posterImage.src}
      muted
      loop
      playsinline
      preload="metadata"
      aria-label={alt || undefined}
      aria-hidden={alt ? undefined : 'true'}
    ></video>
    <Image
      class="device__frame"
      src={frame}
      alt=""
      widths={[400, 800, 1200]}
      sizes="(max-width: 48rem) 45vw, 30vw"
      format="webp"
      loading={eager ? 'eager' : 'lazy'}
    />
  </div>
</div>

<style>
  .device-tile {
    position: absolute;
    inset: 0;
    outline: none;
    -webkit-tap-highlight-color: transparent;
  }

  /* The frame image is 450×920 with the screen at 24,23, 402×874. */
  .device {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    aspect-ratio: 450 / 920;
    transform-origin: 0 0;
    transition: transform var(--duration-device) var(--ease-out-quad);
  }

  .device-tile.is-active .device {
    transform: translate(var(--dx), var(--dy)) scale(var(--k));
  }

  .device__screen {
    position: absolute;
    left: 5.333%;
    top: 2.5%;
    width: 89.333%;
    height: 95%;
    object-fit: cover;
    /* The screen's corners: 62pt on a 402×874 screen. */
    border-radius: 15.4% / 7.1%;
    background: var(--figure);
  }

  .device__frame {
    position: relative;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .device-tile:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: -2px;
    border-radius: inherit;
  }
</style>

<script>
  // Hover on devices that hover; tap toggles on touch; focus for keyboards.
  for (const tile of document.querySelectorAll<HTMLElement>('[data-device-tile]')) {
    const video = tile.querySelector('video')!;
    let rewind = 0;

    const set = (on: boolean) => {
      if (on === tile.classList.contains('is-active')) return;
      tile.classList.toggle('is-active', on);
      clearTimeout(rewind);
      if (on) {
        video.play().catch(() => {});
      } else {
        video.pause();
        // Back to the first frame once the phone has settled.
        rewind = window.setTimeout(() => (video.currentTime = 0), 300);
      }
    };

    tile.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && set(true));
    tile.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && set(false));
    tile.addEventListener('click', (e) => {
      if ((e as PointerEvent).pointerType !== 'mouse') set(!tile.classList.contains('is-active'));
    });
    tile.addEventListener('focus', () => tile.matches(':focus-visible') && set(true));
    tile.addEventListener('blur', () => set(false));
    tile.addEventListener('keydown', (e) => e.key === 'Escape' && set(false));
  }
</script>
