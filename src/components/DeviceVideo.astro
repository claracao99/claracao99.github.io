---
/**
 * A prototype clip in the iPhone 17 frame (Figma Cover page, "iPhone
 * Mockups"), on Figure grey.
 *
 * The phone sits still where `stage` puts it and the clip loops on its own,
 * playing while any of the tile is on screen and pausing when it leaves.
 * Under prefers-reduced-motion it never starts and the first frame (the
 * poster) stands in.
 *
 * `stage` is the phone's left, top and width in px on a 347.5×434.375 card,
 * measured on the Figma board "Device tile · phone positions" (549:1867),
 * and scales with the card. The default is marco.fyi's: large and low,
 * running off the bottom edge. All three values scale with the card's
 * width, so the phone keeps its place from the top edge on the square card
 * at every size.
 *
 * Fills its parent, which must be positioned and clip its overflow.
 */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import frame from '../assets/device/iphone-17-black.png';

interface Props {
  video: string;
  /** The clip's first frame. */
  poster: ImageMetadata;
  alt?: string;
  eager?: boolean;
  /** Phone left, top and width in px on a 347.5×434.375 card. */
  stage?: { x: number; y: number; w: number };
  /** On a case page: the grid's full width, two tiles on desktop. */
  wide?: boolean;
}

const CARD = { w: 347.5, h: 434.375 };

const {
  video,
  poster,
  alt = '',
  eager = false,
  wide = false,
  stage = { x: 27.8, y: 137.7, w: 291.9 },
} = Astro.props;
const style = [
  `--x: ${(stage.x / CARD.w) * 100}%`,
  `--y: ${(stage.y / CARD.w) * 100}cqw`,
  `--w: ${(stage.w / CARD.w) * 100}%`,
].join('; ');
const posterImage = await getImage({ src: poster, width: 750, format: 'webp' });
---

<div class="device-tile">
  <div class="device" style={style}>
    <video
      class="device__screen"
      src={video}
      poster={posterImage.src}
      muted
      loop
      playsinline
      preload={eager ? 'auto' : 'metadata'}
      aria-label={alt || undefined}
      aria-hidden={alt ? undefined : 'true'}
      data-device-video
    ></video>
    <Image
      class="device__frame"
      src={frame}
      alt=""
      widths={[400, 800, 1200]}
      sizes={`(max-width: 32rem) 90vw, ${wide ? 430 : 220}px`}
      format="webp"
      loading={eager ? 'eager' : 'lazy'}
    />
  </div>
</div>

<style>
  .device-tile {
    position: absolute;
    inset: 0;
    /* For --y, which is in cqw of the card. */
    container-type: inline-size;
  }

  /* The frame image is 450×920 with the screen at 24,23, 402×874. */
  .device {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    aspect-ratio: 450 / 920;
  }

  .device__screen {
    position: absolute;
    left: 5.333%;
    top: 2.5%;
    width: 89.333%;
    height: 95%;
    object-fit: cover;
    /* The screen's corners: 62pt on a 402×874 screen. */
    border-radius: 15.4% / 7.1%;
    background: var(--figure);
  }

  .device__frame {
    position: relative;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>

<script>
  // Play each clip while any of it is on screen, pause it when it leaves.
  const observer = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    ? null
    : new IntersectionObserver((entries) => {
        for (const { target, isIntersecting } of entries) {
          const v = target as HTMLVideoElement;
          if (isIntersecting) v.play().catch(() => {});
          else v.pause();
        }
      });

  document.querySelectorAll<HTMLVideoElement>('[data-device-video]').forEach((v) => observer?.observe(v));
</script>
