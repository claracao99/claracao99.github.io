---
/**
 * Index ↔ case-study page transition: the header stays put while the pages
 * under it crossfade in place, both at once, so there is no blank frame
 * between them. Leaving from an index tile, both sides show the same loading
 * squares and the tile's outline, so the swap itself is all but invisible.
 *
 * Native cross-document View Transitions, no library: pages still load in
 * full, so Lenis is untouched. Browsers without support, and
 * prefers-reduced-motion, get a plain load. Only index ↔ case and case →
 * case navigations animate; the rest are skipped.
 *
 * Rendered inside <head>: the pagereveal listener has to exist before the
 * new page's first frame.
 */
---

<script is:inline>
  (() => {
    const kind = (url) => {
      if (!url) return null;
      let path;
      try {
        path = new URL(url, location.href).pathname.replace(/\/+$/, '') || '/';
      } catch {
        return null;
      }
      if (path === '/') return 'work';
      if (/^\/work\/[^/]+$/.test(path)) return 'case';
      return null;
    };

    // The header's transition name is only set while a transition runs: a
    // named element is a backdrop root, which would stop backdrop-filter glass
    // from blurring the work behind it. Leaving page: set before the
    // snapshot; cleared if the page comes back from the bfcache.
    const root = document.documentElement;
    window.addEventListener('pageswap', (e) => {
      if (e.viewTransition) root.dataset.vtNav = '';
    });
    window.addEventListener('pageshow', () => delete root.dataset.vtNav);

    window.addEventListener('pagereveal', (e) => {
      const vt = e.viewTransition;
      if (!vt) return;
      const from = kind(navigation?.activation?.from?.url ?? document.referrer);
      const to = kind(location.href);
      if (!from || !to || (from === 'work' && to === 'work')) {
        vt.skipTransition();
        return;
      }
      root.dataset.vtNav = '';
      vt.finished.finally(() => delete root.dataset.vtNav);
    });
  })();
</script>

<!-- Opt-in inline rather than bundled: the browser checks it on the arriving
     page at reveal, and a stylesheet still in flight occasionally counts as
     "not opted in". -->
<style is:inline>
  @media (prefers-reduced-motion: no-preference) {
    @view-transition {
      navigation: auto;
    }
  }
</style>

<style is:global>
  /* The header holds still while the page under it changes. Only during a
   * transition; see the pageswap listener. */
  [data-vt-nav] .nav {
    view-transition-name: site-nav;
  }

  ::view-transition {
    background: var(--transition-backdrop);
  }

  /* Added together, not laid one over the other: the two opacities always sum
   * to 1, so whatever is the same on both pages (the squares, the outline handed
   * over in place) holds perfectly still. Laid over each other, both at 50%
   * cover only 75%, and the backdrop shows through as a blink. The UA's own
   * crossfade does the same, but setting `animation` drops it. */
  ::view-transition-image-pair(root) {
    isolation: isolate;
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    mix-blend-mode: plus-lighter;
  }

  ::view-transition-old(root) {
    animation: vt-fade-out var(--duration-page) var(--ease-page) both;
  }

  ::view-transition-new(root) {
    animation: vt-fade-in var(--duration-page) var(--ease-page) both;
  }

  @keyframes vt-fade-out {
    to {
      opacity: 0;
    }
  }

  @keyframes vt-fade-in {
    from {
      opacity: 0;
    }
  }
</style>
