---
/**
 * Custom cursor, after templo.co.uk: a small white dot that tracks the
 * pointer exactly and blends by exclusion, so it reads black over white and
 * inverts whatever photo or video it crosses. One size, never changing; the
 * size is a token.
 *
 * Over anything marked `data-cursor-frame` (the index cards) it becomes a
 * frame too, after otherkind.design: a grey outline grows out from the dot to
 * wrap the target, one --cursor-frame-gap outside it, while the dot stays. The frame holds still while the pointer moves inside the target and
 * shrinks back into the pointer on the way out.
 *
 * Mouse and trackpad only (fine pointer that can hover), at any window
 * width; touch screens keep the system cursor. The
 * dot stays hidden until the first move and while the pointer is outside
 * the window, except that it carries over from the page before: a link
 * followed without moving the mouse leaves it where it was.
 */
---

<div class="cursor" aria-hidden="true" data-cursor></div>
<div class="cursor-frame" aria-hidden="true" data-cursor-frame-box></div>

<style>
  .cursor,
  .cursor-frame {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    :global(html.has-cursor),
    :global(html.has-cursor *) {
      cursor: none !important;
    }

    .cursor {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      z-index: var(--z-cursor);
      width: var(--cursor-size);
      height: var(--cursor-size);
      margin: calc(var(--cursor-size) / -2) 0 0 calc(var(--cursor-size) / -2);
      border-radius: 50%;
      background: var(--cursor-fill);
      mix-blend-mode: exclusion;
      pointer-events: none;
      opacity: 0;
      transition: opacity var(--duration-fast) linear;
    }

    .cursor[data-visible] {
      opacity: 1;
    }

    /* Over the card, so it is seen growing out of the dot. Position and
     * size are set by the script; they animate. */
    .cursor-frame {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      z-index: var(--z-cursor-frame);
      border: var(--rule-width) solid var(--cursor-frame-line);
      pointer-events: none;
      opacity: 0;
      transition-property: top, left, width, height, border-radius, opacity;
      transition-duration: var(--duration-cursor-frame);
      transition-timing-function: var(--ease-standard);
    }

    .cursor-frame[data-snap] {
      transition: none;
    }

    .cursor-frame[data-visible] {
      opacity: 1;
    }

    /* Leaving the index from a tile (index.astro): the tile travels on alone. */
    :global(html[data-leaving]) .cursor-frame[data-visible] {
      opacity: 0;
    }
  }
</style>

<script>
  const cursor = document.querySelector<HTMLElement>('[data-cursor]');
  const frame = document.querySelector<HTMLElement>('[data-cursor-frame-box]');
  const query = window.matchMedia('(hover: hover) and (pointer: fine)');

  if (cursor && frame) {
    const sync = () => document.documentElement.classList.toggle('has-cursor', query.matches);
    sync();
    query.addEventListener('change', sync);

    let target: HTMLElement | null = null;
    let x = 0;
    let y = 0;

    const px = (n: number) => `${n}px`;
    const css = (name: string) =>
      parseFloat(getComputedStyle(document.documentElement).getPropertyValue(name)) || 0;

    // Collapsed into the pointer: the size of the dot, round.
    const atPointer = () => {
      const size = css('--cursor-size');
      Object.assign(frame.style, {
        left: px(x - size / 2),
        top: px(y - size / 2),
        width: px(size),
        height: px(size),
        borderRadius: '50%',
      });
    };

    // Wrapping the target, one gap outside, its radius grown by the same.
    const around = (el: HTMLElement) => {
      const r = el.getBoundingClientRect();
      const gap = css('--cursor-frame-gap');
      const radius = parseFloat(getComputedStyle(el).borderTopLeftRadius) || 0;
      Object.assign(frame.style, {
        left: px(r.left - gap),
        top: px(r.top - gap),
        width: px(r.width + 2 * gap),
        height: px(r.height + 2 * gap),
        borderRadius: px(radius + gap),
      });
    };

    const enter = (el: HTMLElement) => {
      target = el;
      frame.toggleAttribute('data-snap', true);
      atPointer();
      void frame.offsetWidth; // commit the start before animating from it
      frame.removeAttribute('data-snap');
      frame.toggleAttribute('data-visible', true);
      around(el);
    };

    const leave = () => {
      target = null;
      atPointer();
      frame.removeAttribute('data-visible');
    };

    // Where the pointer was on the page before, if it was only just left.
    try {
      const last = JSON.parse(sessionStorage.getItem('cursor') || 'null');
      if (last && Date.now() - last.at < 5000) {
        x = last.x;
        y = last.y;
        cursor.style.translate = `${x}px ${y}px`;
        cursor.toggleAttribute('data-visible', true);
      }
    } catch {}
    window.addEventListener('pagehide', () => {
      if (!cursor.hasAttribute('data-visible')) return;
      try {
        sessionStorage.setItem('cursor', JSON.stringify({ x, y, at: Date.now() }));
      } catch {}
    });

    document.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      x = e.clientX;
      y = e.clientY;
      cursor.style.translate = `${x}px ${y}px`;
      let over = (e.target as Element).closest?.<HTMLElement>('[data-cursor-frame]') ?? null;
      // The index rail's tiles turn in 3D: a flat frame doesn't fit them.
      if (over?.closest('.rail[data-active]')) over = null;
      if (over !== target) (over ? enter(over) : leave());
      cursor.toggleAttribute('data-visible', true);
    });

    // The page can move under a held frame (scroll, resize): follow it.
    const follow = () => target && around(target);
    window.addEventListener('scroll', follow, { passive: true });
    window.addEventListener('resize', follow);

    document.documentElement.addEventListener('pointerleave', () => {
      if (target) leave();
      cursor.removeAttribute('data-visible');
    });
  }
</script>
