---
/**
 * Footer: hairline, email on the left, LinkedIn icon on the right.
 * Addresses come from CONTACT in consts.ts so they live in one place.
 */
import { CONTACT } from '../consts';

const email = CONTACT.find((c) => c.href.startsWith('mailto:'))!;
const linkedin = CONTACT.find((c) => c.label === 'LinkedIn')!;
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__inner">
      <a class="footer__link" href={email.href}>{email.label}</a>
      <a
        class="footer__icon"
        href={linkedin.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn (opens in a new tab)"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"
          />
        </svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-11);
  }

  .footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding-block: var(--space-4);
  }

  /* Same treatment as the header links; min-height keeps the 44px target. */
  .footer__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-title);
    color: var(--ink);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-out);
  }

  .footer__link:hover,
  .footer__link:focus-visible {
    color: var(--ink-muted);
  }

  .footer__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-right: calc(-1 * var(--space-3));
    border-radius: var(--radius-md);
    color: var(--ink);
  }

  .footer__icon:hover {
    background: var(--surface-hover);
  }
</style>
