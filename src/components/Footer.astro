---
/**
 * Footer (01 Index): mirrors the header. The email pill copies the address
 * (two tracks on desktop, its own row on phones); LinkedIn and CV open in a
 * new tab. Addresses come from
 * CONTACT in consts.ts so they live in one place.
 */
import { CONTACT } from '../consts';
import TriangleEast from '../icons/triangle-east.svg';

const email = CONTACT.find((c) => c.href.startsWith('mailto:'))!;
const links = CONTACT.filter((c) => !c.href.startsWith('mailto:'));
---

<footer class="footer">
  <div class="index-grid">
    <button class="pill pill--filled span-wide footer__copy" type="button" data-copy={email.label}>
      <span>{email.label}</span>
      <span class="detail" aria-live="polite" data-copy-status>Copy</span>
    </button>
    {
      links.map((link) => (
        <a class="pill pill--filled" href={link.href} target="_blank" rel="noopener noreferrer">
          <span>
            {link.label}
            <span class="visually-hidden"> (opens in a new tab)</span>
          </span>
          <TriangleEast aria-hidden="true" />
        </a>
      ))
    }
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--footer-space);
    padding-bottom: var(--index-margin);
  }

  .footer__copy {
    text-align: left;
  }
</style>

<script>
  // Copy the address; say so for a moment, then put "Copy" back. Without the
  // clipboard API (insecure context, old browser) fall back to mailto.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const status = button.querySelector<HTMLElement>('[data-copy-status]');
    let timer = 0;
    button.addEventListener('click', async () => {
      const address = button.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(address);
      } catch {
        window.location.href = `mailto:${address}`;
        return;
      }
      if (!status) return;
      status.textContent = 'Copied';
      clearTimeout(timer);
      timer = window.setTimeout(() => (status.textContent = 'Copy'), 1600);
    });
  }
</script>
