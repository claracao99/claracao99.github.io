---
/**
 * Footer (01 Index): mirrors the header, on the same glass. The email pill
 * copies the address (two tracks on desktop, its own row on phones);
 * LinkedIn and CV open in a new tab. Addresses come from CONTACT in
 * consts.ts so they live in one place.
 */
import { CONTACT } from '../consts';
import TriangleEast from '../icons/triangle-east.svg';

const email = CONTACT.find((c) => c.href.startsWith('mailto:'))!;
const links = CONTACT.filter((c) => !c.href.startsWith('mailto:'));
---

<footer class="footer">
  <div class="index-grid">
    <button class="pill span-wide footer__copy" type="button" data-copy={email.label}>
      <span>{email.label}</span>
      <span class="detail" aria-live="polite" data-copy-status>Copy</span>
    </button>
    {
      links.map((link) => (
        <a class="pill" href={link.href} target="_blank" rel="noopener noreferrer">
          <span>
            {link.label}
            <span class="visually-hidden"> (opens in a new tab)</span>
          </span>
          <TriangleEast aria-hidden="true" />
        </a>
      ))
    }
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--footer-space);
    padding-bottom: var(--index-margin);
  }

  .footer__copy {
    text-align: left;
  }

  /* Pinned to the bottom edge on desktop, like the header to the top, so it
   * holds still while one page changes to the next (PageTransition.astro).
   * The page keeps the same space under its last row. On phones it ends the
   * page, as the header scrolls away there. */
  @media (min-width: 48rem) {
    .footer {
      position: fixed;
      inset-inline: 0;
      bottom: 0;
      z-index: var(--z-nav);
      margin-top: 0;
    }

    :global(body) {
      padding-bottom: var(--footer-height);
    }

    :global(main) {
      padding-bottom: var(--footer-space);
    }
  }
</style>

<script>
  // Copy the address; say so for a moment, then put "Copy" back. Without the
  // clipboard API (insecure context, old browser) fall back to mailto.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const status = button.querySelector<HTMLElement>('[data-copy-status]');
    let timer = 0;
    button.addEventListener('click', async () => {
      const address = button.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(address);
      } catch {
        window.location.href = `mailto:${address}`;
        return;
      }
      if (!status) return;
      status.textContent = 'Copied';
      clearTimeout(timer);
      timer = window.setTimeout(() => (status.textContent = 'Copy'), 1600);
    });
  }
</script>
