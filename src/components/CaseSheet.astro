---
/**
 * Bottom sheet that shows a case study over the landing page.
 *
 * Progressive enhancement: every "Read more" is a real link to /work/<slug>/.
 * This script intercepts plain left-clicks on links marked `data-sheet`,
 * fetches that page, lifts its <article class="case"> into a <dialog>, and
 * pushes the URL so back/forward and refresh behave. Modifier-clicks, middle
 * clicks and no-JS all fall through to the normal page.
 *
 * <dialog>.showModal() gives the scrim, focus trap, Esc and top layer for free.
 */
---

<dialog class="sheet" id="case-sheet" aria-labelledby="case-sheet-title">
  <div class="sheet__bar">
    <p class="sheet__title" id="case-sheet-title"></p>
    <button class="sheet__close" type="button" data-sheet-close aria-label="Close">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </button>
  </div>
  <div class="sheet__scroll">
    <div class="sheet__body" id="case-sheet-body" aria-live="polite"></div>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('case-sheet') as HTMLDialogElement | null;
  const body = document.getElementById('case-sheet-body');
  const title = document.getElementById('case-sheet-title');

  if (dialog && body && title && typeof dialog.showModal === 'function') {
    const cache = new Map<string, Promise<HTMLElement | null>>();
    // Set while we close in response to popstate, so `close` doesn't go back again.
    let closingFromHistory = false;

    const load = (url: string) => {
      if (!cache.has(url)) {
        cache.set(
          url,
          fetch(url, { headers: { Accept: 'text/html' } })
            .then((r) => (r.ok ? r.text() : Promise.reject(r.status)))
            .then((html) => {
              const doc = new DOMParser().parseFromString(html, 'text/html');
              return doc.querySelector<HTMLElement>('article.case');
            })
            .catch(() => null),
        );
      }
      return cache.get(url)!;
    };

    const open = async (url: string, label: string) => {
      title.textContent = label;
      body.replaceChildren();
      if (!dialog.open) dialog.showModal();
      document.documentElement.classList.add('sheet-open');
      dialog.querySelector('.sheet__scroll')!.scrollTop = 0;

      const article = await load(url);
      if (article) {
        // Images inside the fetched article should not compete with the page.
        article.querySelectorAll('img').forEach((img) => img.setAttribute('loading', 'lazy'));
        body.replaceChildren(article);
        const h = article.querySelector('.case__title');
        if (h?.textContent) title.textContent = h.textContent.trim();
      } else {
        // Fetch failed — hand over to the real page rather than show nothing.
        location.href = url;
      }
    };

    const close = () => {
      document.documentElement.classList.remove('sheet-open');
      if (dialog.open) dialog.close();
    };

    document.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.button !== 0) return;
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const link = (e.target as Element).closest<HTMLAnchorElement>('a[data-sheet]');
      if (!link || link.origin !== location.origin) return;
      e.preventDefault();
      const label = link.dataset.sheetTitle ?? '';
      history.pushState({ sheet: link.href, label }, '', link.href);
      open(link.href, label);
    });

    dialog.addEventListener('click', (e) => {
      // A click on the backdrop lands on the <dialog> itself, not a child.
      if (e.target === dialog || (e.target as Element).closest('[data-sheet-close]')) close();
    });

    // Fires after Esc, the close button, or backdrop click.
    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('sheet-open');
      if (!closingFromHistory && history.state?.sheet) history.back();
    });

    window.addEventListener('popstate', (e) => {
      const state = e.state as { sheet?: string; label?: string } | null;
      if (state?.sheet) {
        open(state.sheet, state.label ?? '');
      } else {
        closingFromHistory = true;
        close();
        closingFromHistory = false;
      }
    });
  }
</script>

<style>
  .sheet {
    position: fixed;
    inset: auto 0 0;
    width: min(100% - 2 * var(--space-5), var(--page-max));
    max-width: none;
    max-height: none;
    height: calc(100svh - 8rem);
    margin: 0 auto;
    padding: 0;
    border: 0;
    border-radius: var(--radius-sheet) var(--radius-sheet) 0 0;
    background: var(--surface);
    color: var(--ink);
    overflow: hidden;
    display: none;
    flex-direction: column;
  }

  .sheet[open] {
    display: flex;
    animation: sheet-in var(--duration-slow) var(--ease-out);
  }

  .sheet::backdrop {
    background: var(--scrim);
    animation: scrim-in var(--duration-slow) var(--ease-out);
  }

  @keyframes sheet-in {
    from {
      transform: translateY(6%);
      opacity: 0;
    }
  }

  @keyframes scrim-in {
    from {
      opacity: 0;
    }
  }

  @media (max-width: 48rem) {
    .sheet {
      width: 100%;
      height: calc(100svh - 3rem);
      border-radius: var(--radius-md) var(--radius-md) 0 0;
    }
  }

  /* Pinned top bar: title + close, hairline below. */
  .sheet__bar {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 3.5rem;
    padding-inline: var(--gutter);
    border-bottom: 1px solid var(--rule);
  }

  .sheet__title {
    font-size: var(--text-body);
    font-weight: var(--weight-medium);
    line-height: var(--leading-none);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sheet__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-right: calc(-1 * var(--space-3));
    border-radius: var(--radius-md);
    color: var(--ink);
  }

  .sheet__close:hover {
    background: var(--surface-hover);
  }

  .sheet__scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
</style>

<style is:global>
  /* Lock the page behind an open sheet. */
  html.sheet-open {
    overflow: hidden;
  }
</style>
