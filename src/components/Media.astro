---
/**
 * One visual in a media row: a looping video, a real image, or a placeholder
 * shape until the export exists. Styles live in styles/case.css (global — see
 * the note there).
 *
 * Videos are silent product clips: muted, looped, inline, and only playing
 * while on screen. They have no `autoplay`: the script below starts them, so
 * under prefers-reduced-motion they never start and the poster stands in.
 */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Shape = 'phone' | 'card' | 'pill' | 'bar' | 'tag' | 'panel' | 'sheet' | 'row' | 'none';

interface Props {
  src?: ImageMetadata;
  /** Path under public/. `src` becomes its poster. */
  video?: string;
  alt?: string;
  label?: string;
  shape?: Shape;
  /** Landing hero loads eagerly; everything else lazily. */
  eager?: boolean;
  /** Passed to <img sizes>; defaults to a third of the viewport. */
  sizes?: string;
  /** Candidate widths for srcset. */
  widths?: number[];
}

const {
  src,
  video,
  alt = '',
  label,
  shape = 'none',
  eager = false,
  sizes = '(max-width: 48rem) 100vw, 33vw',
  widths = [480, 960, 1440],
} = Astro.props;

const poster = video && src ? await getImage({ src, width: 1080, format: 'webp' }) : undefined;
---

{
  video && poster ? (
    <figure class="media media--video">
      <video
        src={video}
        poster={poster.src}
        muted
        loop
        playsinline
        preload={eager ? 'auto' : 'none'}
        aria-label={alt || undefined}
        aria-hidden={alt ? undefined : 'true'}
      />
      {label && <figcaption class="visually-hidden">{label}</figcaption>}
    </figure>
  ) : src ? (
    <figure class="media media--image">
      <Image
        src={src}
        alt={alt}
        widths={widths}
        sizes={sizes}
        format="webp"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
      />
      {label && <figcaption class="visually-hidden">{label}</figcaption>}
    </figure>
  ) : (
    <div class="media" role="img" aria-label={label ?? 'Placeholder'}>
      {shape !== 'none' && <div class:list={['media__shape', `media__shape--${shape}`]} />}
      {label && <p class="media__label caps">{label}</p>}
    </div>
  )
}

<script>
  // Play each clip while any of it is on screen, pause it when it leaves.
  const observer =
    window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ? null
      : new IntersectionObserver((entries) => {
          for (const { target, isIntersecting } of entries) {
            const v = target as HTMLVideoElement;
            if (isIntersecting) v.play().catch(() => {});
            else v.pause();
          }
        });

  document.querySelectorAll<HTMLVideoElement>('.media--video video').forEach((v) => observer?.observe(v));
</script>
