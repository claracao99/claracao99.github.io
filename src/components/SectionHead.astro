---
/**
 * Display heading in the serif face: first word roman, the rest italic.
 * e.g. <SectionHead lead="Selected" italic="works" />
 */
interface Props {
  lead: string;
  italic: string;
  as?: 'h1' | 'h2';
  id?: string;
}

const { lead, italic, as: Tag = 'h2', id } = Astro.props;
---

<div class="section-head">
  <Tag class="section-head__title" id={id}>
    {lead}{' '}<em>{italic}</em>
  </Tag>
  <slot />
</div>

<style>
  .section-head {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-5);
    padding-block: var(--space-7) calc(var(--space-6) - var(--space-1));
  }

  .section-head__title {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: var(--weight-normal);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    color: var(--ink-body);
    text-wrap: balance;
  }

  .section-head__title em {
    font-style: italic;
  }
</style>
