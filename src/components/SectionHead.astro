---
/**
 * Display heading in the serif face: first word italic, the rest roman.
 * e.g. <SectionHead italic="Selected" lead="works" />
 */
interface Props {
  /** Italic first word. */
  italic: string;
  /** Roman remainder. */
  lead: string;
  as?: 'h1' | 'h2';
  id?: string;
}

const { lead, italic, as: Tag = 'h2', id } = Astro.props;
---

<div class="section-head">
  <Tag class="section-head__title" id={id}>
    <em>{italic}</em>{' '}{lead}
  </Tag>
  <slot />
</div>

<style>
  .section-head {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-5);
    padding-block: var(--space-11);
  }

  .section-head__title {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: var(--weight-normal);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    color: var(--ink-body);
    text-wrap: balance;
  }

  .section-head__title em {
    font-style: italic;
  }
</style>
