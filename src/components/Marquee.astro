---
/**
 * One line of text that scrolls when it doesn't fit, like a long track name
 * in Spotify's player. Text that fits renders static, untouched.
 *
 * When it overflows: hold, then slide left until a second copy lands exactly
 * where the first began, then hold again. A seamless loop, never a jump back.
 * At rest only the right edge fades (hinting there is more); while moving
 * both edges fade, so letters never look cut.
 *
 *   <Marquee text={caption} />
 *
 * Under prefers-reduced-motion the text stays still and truncates with an
 * ellipsis. Screen readers read the text once: the copy is aria-hidden.
 * Timing knobs are the constants at the top of the script; gap and fade
 * width are tokens.
 */
interface Props {
  text: string;
  class?: string;
}

const { text, class: className } = Astro.props;
---

<span class:list={['marquee', className]} data-marquee>
  <span class="marquee__track">
    <span class="marquee__text">{text}</span>
    <span class="marquee__text marquee__copy" aria-hidden="true">{text}</span>
  </span>
</span>

<style>
  /* Animated by the script alongside the scroll, so the left fade only
   * appears while the text is moving. */
  @property --marquee-fade-start {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }

  .marquee {
    display: block;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
  }

  .marquee__track {
    display: inline-flex;
    gap: var(--marquee-gap);
  }

  .marquee__copy {
    display: none;
  }

  .marquee[data-overflowing] {
    /* A mask is alpha only; the colour keyword is irrelevant. */
    mask-image: linear-gradient(
      to right,
      transparent,
      black var(--marquee-fade-start),
      black calc(100% - var(--marquee-fade)),
      transparent
    );
  }

  .marquee[data-overflowing] .marquee__copy {
    display: inline;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee {
      text-overflow: ellipsis;
    }

    .marquee[data-overflowing] {
      mask-image: none;
    }

    .marquee__track {
      display: inline;
    }

    .marquee[data-overflowing] .marquee__copy {
      display: none;
    }
  }
</style>

<script>
  const SPEED = 32; // px per second while scrolling
  const HOLD_MS = 2200; // still time at the start of every loop

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const setup = (el: HTMLElement) => {
    const track = el.querySelector<HTMLElement>('.marquee__track')!;
    const text = el.querySelector<HTMLElement>('.marquee__text')!;
    let running: Animation[] = [];

    const update = () => {
      running.forEach((a) => a.cancel());
      running = [];

      const overflowing = text.getBoundingClientRect().width > el.clientWidth + 1;
      el.toggleAttribute('data-overflowing', overflowing);
      if (!overflowing || reduceMotion.matches) return;

      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      const fade = getComputedStyle(el).getPropertyValue('--marquee-fade').trim() || '0px';
      const distance = text.getBoundingClientRect().width + gap;
      const duration = HOLD_MS + (distance / SPEED) * 1000;
      const hold = HOLD_MS / duration;
      const timing = { duration, iterations: Infinity };

      running = [
        track.animate(
          [
            { offset: 0, transform: 'translateX(0)' },
            { offset: hold, transform: 'translateX(0)', easing: 'ease-in-out' },
            { offset: 1, transform: `translateX(${-distance}px)` },
          ],
          timing,
        ),
        el.animate(
          [
            { offset: 0, '--marquee-fade-start': '0px' },
            { offset: hold, '--marquee-fade-start': '0px' },
            { offset: hold + 0.05, '--marquee-fade-start': fade },
            { offset: 0.95, '--marquee-fade-start': fade },
            { offset: 1, '--marquee-fade-start': '0px' },
          ],
          timing,
        ),
      ];
    };

    new ResizeObserver(update).observe(el);
    document.fonts.ready.then(update);
    reduceMotion.addEventListener('change', update);
  };

  document.querySelectorAll<HTMLElement>('[data-marquee]').forEach(setup);
</script>
