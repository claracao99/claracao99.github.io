---
/**
 * Unlocks the interface sounds (lib/sound.ts) on the first press or key, as
 * browsers keep audio locked until a user gesture. Links and buttons are
 * silent; only the lamp's cord (Lamp.astro) plays a sound.
 */
---

<script>
  import { unlockSound } from '../lib/sound';

  document.addEventListener('pointerdown', (e) => {
    if (e.button === 0) unlockSound();
  });
  document.addEventListener('keydown', () => unlockSound());
</script>
