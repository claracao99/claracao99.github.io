---
/**
 * "Shipped" outcome list for the end of a case study. Pass items as an array
 * so MDX authors don't hand-write markup:
 *
 *   <Shipped items={['Contact picker…', 'Passenger web link…']} />
 */
interface Props {
  label?: string;
  items: string[];
}

const { label = 'Shipped', items } = Astro.props;
---

<section class="shipped" aria-labelledby="shipped-label">
  <h2 class="shipped__label" id="shipped-label">{label}</h2>
  <ul class="shipped__list">
    {items.map((item) => <li>{item}</li>)}
  </ul>
</section>
