---
/**
 * Site header (01 Index): three pills on the index grid. The wordmark pill
 * is solid Figure, Work and About are glass. The wordmark pill takes four tracks on desktop and its own row on phones; Work (with
 * the project count) and About take one each. About jumps down to the
 * footer's contacts.
 *
 * Fixed on desktop so the pills ride over the work as glass; on phones,
 * where the header is two rows tall, it scrolls away with the page.
 */
import { getPublishedWork } from '../lib/work';
import TriangleSouth from '../icons/triangle-south.svg';

const count = (await getPublishedWork()).filter((e) => !e.data.draft).length;
---

<header class="nav">
  <nav class="index-grid nav__grid" aria-label="Main">
    <a class="pill pill--filled span-wide" href="/">
      <span class="logotype">Clara Cao</span>
      <span>Product Designer</span>
    </a>
    <a class="pill" href="/#work">
      <span>Work</span>
      <span class="detail" aria-label={`${count} projects`}>{String(count).padStart(2, '0')}</span>
    </a>
    <a class="pill" href="#about">
      <span>About</span>
      <TriangleSouth aria-hidden="true" data-direction="south" />
    </a>
  </nav>
</header>

<style>
  /* Out of the flow: pages start at the very top and clear it with
   * --nav-height (base.css pads <main>; case pages pull back under it). */
  .nav {
    position: absolute;
    inset-inline: 0;
    top: 0;
    z-index: var(--z-nav);
  }

  .nav__grid {
    padding-block: var(--index-margin);
  }

  @media (min-width: 48rem) {
    .nav {
      position: fixed;
    }
  }
</style>
