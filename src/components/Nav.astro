---
/**
 * Site header (01 Index): one glass pill across the index grid (yuriroga.com's
 * About-panel frost: #F0F0F0 at 50% under a 50px blur), the
 * wordmark, linking home. Off the index it is the way back.
 *
 * On the index the pill is the current page: clicking it does nothing rather
 * than reloading (a modified click still opens a new tab).
 *
 * Fixed on desktop so the pill rides over the work; on phones it scrolls
 * away with the page.
 */
const isHome = Astro.url.pathname === '/';
---

<header class="nav">
  <nav class="index-grid nav__grid" aria-label="Main">
    <a class="pill nav__pill" href="/" aria-current={isHome ? 'page' : undefined}>
      <span class="logotype">Clara Cao</span>
    </a>
  </nav>
</header>

<style>
  /* Out of the flow: pages start at the very top and clear it with
   * --nav-height (base.css pads <main>; case pages pull back under it). */
  .nav {
    position: absolute;
    inset-inline: 0;
    top: 0;
    z-index: var(--z-nav);
  }

  .nav__grid {
    padding-block: var(--index-margin);
  }

  .nav__pill {
    grid-column: 1 / -1;
  }

  @media (min-width: 48rem) {
    .nav {
      position: fixed;
    }
  }
</style>

<script>
  // The current page's link: a plain click would only reload it.
  for (const link of document.querySelectorAll<HTMLAnchorElement>('.nav a[aria-current="page"]')) {
    link.addEventListener('click', (e) => {
      if (e.button === 0 && !e.metaKey && !e.ctrlKey && !e.shiftKey && !e.altKey) e.preventDefault();
    });
  }
</script>
