---
/**
 * Site navigation. No JS: three links fit comfortably on a phone, so there's
 * no burger menu to hydrate. If the nav ever outgrows one row, use a
 * <details> disclosure rather than reaching for a framework.
 */
import { SITE, NAV_LINKS } from '../consts';

// Normalise both sides so `/work` and `/work/` compare equal, and mark parents
// of nested routes (a case study should light up "Work").
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

function isCurrent(href: string) {
  const target = href.replace(/\/+$/, '') || '/';
  if (target === '/') return path === '/';
  return path === target || path.startsWith(`${target}/`);
}
---

<header class="nav">
  <div class="wrap nav__inner">
    <a class="nav__home" href="/">{SITE.name}</a>
    <nav aria-label="Main">
      <ul class="nav__list">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    border-bottom: 1px solid var(--rule);
    background: var(--surface);
  }

  .nav__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    padding-block: var(--space-3);
  }

  /* inline-flex + min-height rather than padding: guarantees the 44px tap
   * target regardless of how the fluid font size resolves. */
  .nav__home {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-tight);
    color: var(--ink);
    text-decoration: none;
  }

  .nav__list {
    display: flex;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__list a {
    display: inline-flex;
    align-items: center;
    /* 44px minimum tap target, without visually padding the row. */
    min-height: 44px;
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    text-decoration: none;
    letter-spacing: var(--tracking-wide);
  }

  .nav__list a:hover {
    color: var(--ink);
  }

  .nav__list a[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline;
  }
</style>
