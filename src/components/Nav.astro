---
/**
 * Site header: name on the left, one link on the right that swaps between
 * "About" and "Work" depending on where you are. No JS.
 */
import { SITE } from '../consts';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const onAbout = path === '/about';
const link = onAbout
  ? { href: '/', label: 'Work' }
  : { href: '/about/', label: 'About' };
---

<header class="nav">
  <div class="wrap nav__inner">
    <a class="nav__link nav__home" href="/">{SITE.name}</a>
    <nav aria-label="Main">
      <a class="nav__link" href={link.href}>{link.label}</a>
    </nav>
  </div>
</header>

<style>
  /* Fixed and out of the flow: pages start at the very top and scroll behind
   * the two links. No background, no rule. Pages that want to clear it use
   * --nav-height (base.css pads <main>; case pages pull back under it). */
  .nav {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: var(--z-nav);
    pointer-events: none;
  }

  .nav__link {
    pointer-events: auto;
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding-block: var(--space-4);
  }

  /* inline-flex + min-height guarantees the 44px tap target. */
  .nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    /* Body size, bold: the "navigate" link role. */
    font-size: var(--text-body);
    font-weight: var(--weight-bold);
    line-height: var(--leading-none);
    letter-spacing: var(--tracking-title);
    color: var(--ink);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-out);
  }

  .nav__link:hover {
    color: var(--ink-muted);
  }
</style>
