---
/**
 * Site header: name on the left, one link on the right that swaps between
 * "About me" and "Work" depending on where you are. No JS.
 */
import { SITE } from '../consts';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const onAbout = path === '/about';
const link = onAbout
  ? { href: '/', label: 'Work' }
  : { href: '/about/', label: 'About me' };
---

<header class="nav">
  <div class="wrap nav__inner">
    <a class="nav__link nav__home" href="/">{SITE.name}</a>
    <nav aria-label="Main">
      <a class="nav__link" href={link.href}>{link.label}</a>
    </nav>
  </div>
  <div class="wrap"><hr class="rule" /></div>
</header>

<style>
  /* Sticky so the name and the one nav link stay reachable while scrolling.
   * Opaque background because content passes underneath. */
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background: var(--surface);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding-block: var(--space-4);
  }

  /* inline-flex + min-height guarantees the 44px tap target. */
  .nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-body);
    font-weight: var(--weight-medium);
    line-height: var(--leading-none);
    color: var(--ink);
    text-decoration: none;
  }

  .nav__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
