---
/**
 * A "Fun stuff" tile: media well, title, date, one line of description.
 */
import Media from './Media.astro';
import type { FunEntry } from '../lib/work';

interface Props {
  entry: FunEntry;
}

const { entry } = Astro.props;
const { title, summary, date, media, externalUrl, draft } = entry.data;
---

<article class="small">
  <div class="small__media">
    <Media {...media} sizes="(max-width: 48rem) 100vw, 33vw" />
  </div>
  <div class="small__caption">
    <h3 class="small__title title">
      {
        externalUrl ? (
          <a href={externalUrl} target="_blank" rel="noopener noreferrer">
            {title}<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        ) : (
          title
        )
      }
      {draft && <span class="small__draft">Draft</span>}
    </h3>
    <p class="caps">{date}</p>
    <p class="small__summary">{summary}</p>
  </div>
</article>

<style>
  .small {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  /* Fun tiles are shorter than the work rows. */
  .small__media {
    --media-ratio: 437 / 300;
  }

  .small__caption {
    display: grid;
    gap: var(--space-2);
  }

  .small__title a {
    color: inherit;
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-out);
  }

  .small__title a:hover,
  .small__title a:focus-visible {
    color: var(--ink-muted);
  }

  .small__draft {
    margin-left: var(--space-2);
    padding: 2px var(--space-2);
    border: 1px dashed var(--rule);
    border-radius: var(--radius-sm);
    font: var(--weight-normal) var(--text-label) var(--font-mono);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
    vertical-align: middle;
  }

  .small__summary {
    color: var(--ink-body);
  }
</style>
